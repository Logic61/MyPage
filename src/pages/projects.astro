---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';


// 项目数据（之后你也可以把它们放进 src/content/projects 里让它完全自动化）
const projects = [
  {
    name: "燕园一处 · AWE PKU",
    stack: "Python · MCP",
    desc: "在本机运行的北大校园信息技能。",
    points: [
      "检索教学网作业、公告和课表，查找校园活动并回到原文核验。",
      "按评论数筛选树洞帖，分页读取评论，采集日报并核对覆盖范围。",
      "网页工作台、CLI、MCP 和 HTTP 接口共用本机连接器。"
    ],
    github: "https://github.com/Logic61/pku-campus-skill"
  },
  {
    name: "SurfSoul",
    stack: "JavaScript",
    desc: "基于 SurfCore 的 AI 陪伴项目，连接 QQ、B 站和桌宠。",
    points: [
      "分层记忆将过往互动整理为可编辑的叙事，结合角色自我记录和文档记忆，按需召回带出处的原文。",
      "桌宠可以在对话中按需查看共享屏幕，也能根据屏幕上的活动判断何时适合主动搭话。桌宠与 QQ 共用这套判断机制。",
      "为 B 站视频生成可引用的编号分镜，每格附有时间段和台词。"
    ],
    github: "https://github.com/Logic61/SurfSoul"
  },
  {
    name: "PKU Planner",
    stack: "C++ · Qt",
    desc: "面向北大学生的课程与截止日期管理桌面应用。",
    points: [
      "从教学网同步课表和任务，也能从课表截图中识别课程信息。",
      "根据最近的截止日期给课程格子着色，悬停即可查看该课程的待办。",
      "结合课表与截止日期生成个性化的 AI 学习建议。"
    ],
    github: "https://github.com/Logic61/PKU-Planner"
  }
];
---
<Layout title="项目 - Shane Lorien">
  <div class="site-shell">
    <Navigation />
    <main id="main-content" class="site-content">
      <header class="page-heading">
        <h1>项目</h1>
        <p>一些开源仓库。</p>
      </header>
      <div class="project-list">
        {projects.map(proj => (
          <section class="project">
            <div>
              <div class="project-title">
                <h2>{proj.name}</h2>
                <a class="icon-button" href={proj.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${proj.name}`}><Icon name="mdi:arrow-top-right" /></a>
              </div>
              <p>{proj.desc}</p>
              <div class="project-stack">{proj.stack}</div>
            </div>
            <ul>{proj.points.map(point => <li>{point}</li>)}</ul>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
