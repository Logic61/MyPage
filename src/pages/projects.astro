---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';

const LANG_COLORS: Record<string, string> = {
  "C++": "#f34b7d",
  "Python": "#3572A5",
  "JavaScript": "#f1e05a",
};

// 项目数据（之后你也可以把它们放进 src/content/projects 里让它完全自动化）
const projects = [
  {
    name: "AmazonChess",
    stack: "C++",
    desc: "北京大学计算概论A 2025秋大作业：亚马逊棋",
    points: [
      "实现基础棋盘逻辑、合法落子判定与障碍物检测",
      "使用 C++ 编写核心博弈逻辑框架",
      "良好的代码组织与模块化实现"
    ],
    github: "https://github.com/Logic61/AmazonChess"
  },
  {
    name: "Obsidian-to-Hexo",
    stack: "Python",
    desc: "将 Obsidian 的 Markdown 笔记迁移至 Hexo 博客的自动化工具",
    points: [
      "解析并转换 Obsidian 特有语法的 Markdown 文档",
      "自动适配与转移到 Hexo 的 posts 目录，并整理元数据",
      "由 Python 编写以实现批量无缝备份与发布"
    ],
    github: "https://github.com/Logic61/Obsidian-to-Hexo"
  },
  {
    name: "Carnival-game-suite",
    stack: "JavaScript",
    desc: "一系列基于网页的小游戏集合项目",
    points: [
      "完整使用 JavaScript 构建网页端的交互逻辑",
      "实现了基础的概率机制、事件监听和界面反馈",
      "作为趣味性的前端开发与组件化练习"
    ],
    github: "https://github.com/Logic61/Carnival-game-suite"
  }
];
---

<Layout title="项目 - Shane Lorien">
  <main class="max-w-5xl mx-auto px-6 sm:px-10 py-10 sm:py-12 text-stone-900 dark:text-stone-100 leading-relaxed min-h-[100dvh] flex flex-col transition-colors duration-300">
    <Navigation />

    <header class="pb-10 sm:pb-12">
      <h1 class="font-serif font-medium text-5xl sm:text-6xl tracking-tight text-stone-900 dark:text-stone-50">项目</h1>
      <p class="mt-4 font-serif text-sm text-stone-400 dark:text-stone-500">一些开源仓库。</p>
    </header>

    <!-- hairline grid: gap-px renders the table lines -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-px bg-stone-200 dark:bg-stone-800 border border-stone-200 dark:border-stone-800">
      {projects.map(proj => (
        <section class="group flex flex-col p-6 sm:p-7 bg-paper dark:bg-night hover:bg-stone-50 dark:hover:bg-stone-900/60 transition-colors">
          <div class="flex items-center justify-between gap-3 mb-3">
            <h2 class="font-serif text-xl font-semibold text-stone-900 dark:text-stone-100 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
              {proj.name}
            </h2>
            <a href={proj.github} target="_blank" rel="noopener noreferrer" class="text-stone-300 dark:text-stone-600 hover:text-accent dark:hover:text-accent-dark transition-colors" aria-label="GitHub Repository">
              <Icon name="mdi:github" class="w-5 h-5" />
            </a>
          </div>
          <p class="font-serif text-[15px] text-stone-600 dark:text-stone-300 mb-5">{proj.desc}</p>
          <ul class="font-serif text-[15px] text-stone-500 dark:text-stone-400 space-y-2 flex-1">
            {proj.points.map(pt => (
              <li class="flex items-start gap-2.5">
                <span class="text-accent dark:text-accent-dark select-none">·</span>
                <span class="leading-relaxed">{pt}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 pt-4 border-t border-stone-100 dark:border-stone-800/70 flex items-center gap-2 font-serif text-sm text-stone-500 dark:text-stone-400">
            <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${LANG_COLORS[proj.stack] || '#8b949e'}`}></span>
            <span>{proj.stack}</span>
          </div>
        </section>
      ))}
    </div>

    <Footer />
  </main>
</Layout>
