---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';


// 项目数据（之后你也可以把它们放进 src/content/projects 里让它完全自动化）
const projects = [
  {
    name: "AmazonChess",
    stack: "C++",
    desc: "北京大学计算概论A 2025秋大作业：亚马逊棋",
    points: [
      "实现基础棋盘逻辑、合法落子判定与障碍物检测",
      "使用 C++ 编写核心博弈逻辑框架",
      "良好的代码组织与模块化实现"
    ],
    github: "https://github.com/Logic61/AmazonChess"
  },
  {
    name: "Obsidian-to-Hexo",
    stack: "Python",
    desc: "将 Obsidian 的 Markdown 笔记迁移至 Hexo 博客的自动化工具",
    points: [
      "解析并转换 Obsidian 特有语法的 Markdown 文档",
      "自动适配与转移到 Hexo 的 posts 目录，并整理元数据",
      "由 Python 编写以实现批量无缝备份与发布"
    ],
    github: "https://github.com/Logic61/Obsidian-to-Hexo"
  },
  {
    name: "Carnival-game-suite",
    stack: "JavaScript",
    desc: "一系列基于网页的小游戏集合项目",
    points: [
      "完整使用 JavaScript 构建网页端的交互逻辑",
      "实现了基础的概率机制、事件监听和界面反馈",
      "作为趣味性的前端开发与组件化练习"
    ],
    github: "https://github.com/Logic61/Carnival-game-suite"
  }
];
---
<Layout title="项目 - Shane Lorien">
  <div class="site-shell">
    <Navigation />
    <main id="main-content" class="site-content">
      <header class="page-heading">
        <h1>项目</h1>
        <p>一些开源仓库。</p>
      </header>
      <div class="project-list">
        {projects.map(proj => (
          <section class="project">
            <div>
              <div class="project-title">
                <h2>{proj.name}</h2>
                <a class="icon-button" href={proj.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${proj.name}`}><Icon name="mdi:arrow-top-right" /></a>
              </div>
              <p>{proj.desc}</p>
              <div class="project-stack">{proj.stack}</div>
            </div>
            <ul>{proj.points.map(point => <li>{point}</li>)}</ul>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
