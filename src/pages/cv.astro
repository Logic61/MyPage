---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
---

<Layout title="陈冠宇 - Curriculum Vitae">
  <main class="max-w-[68ch] mx-auto px-6 sm:px-10 py-12 sm:py-16 bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-200 font-serif leading-normal transition-colors duration-300 min-h-screen">

    <Navigation />

    <!-- Header: left-aligned, two-line identity block -->
    <header class="mb-10 pb-5 border-b border-slate-300 dark:border-slate-700">
      <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-slate-900 dark:text-slate-50">陈冠宇</h1>
      <p class="font-sans text-[12px] tracking-[0.18em] uppercase text-slate-500 dark:text-slate-400 mt-1.5">Guan-Yu Chen · Shane Lorien</p>

      <div class="font-sans text-[12px] text-slate-600 dark:text-slate-400 mt-5 grid sm:grid-cols-[auto_1fr] gap-x-8 gap-y-1 tabular-nums">
        <span class="uppercase tracking-[0.14em] text-slate-500 dark:text-slate-500">Address</span>
        <span>北京市海淀区北京大学 · 信息科学技术学院</span>

        <span class="uppercase tracking-[0.14em] text-slate-500 dark:text-slate-500">Email</span>
        <a href="mailto:logic.dreemurr@gmail.com" class="hover:text-slate-900 dark:hover:text-slate-200 underline underline-offset-4 decoration-slate-300 dark:decoration-slate-700">logic.dreemurr@gmail.com</a>

        <span class="uppercase tracking-[0.14em] text-slate-500 dark:text-slate-500">GitHub</span>
        <a href="https://github.com/logic61" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200 underline underline-offset-4 decoration-slate-300 dark:decoration-slate-700">github.com/logic61</a>
      </div>
    </header>

    <div class="space-y-9">

      <!-- Research Interests -->
      <section>
        <h2 class="section-heading"><span class="section-num">I.</span>Research Interests</h2>
        <p class="text-[15px] text-slate-700 dark:text-slate-300">
          Efficient deep learning systems; GPU programming and compiler stacks (CUDA, Triton, TileLang); multimodal representation learning, with current focus on behaviour and affect recognition in non-human animals.
        </p>
      </section>

      <!-- Education -->
      <section>
        <h2 class="section-heading"><span class="section-num">II.</span>Education</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">北京大学 · Peking University</span>
              <span class="cv-date">2025.09 — Present</span>
            </div>
            <p class="cv-sub">信息科学技术学院 · B.E. 计算机科学与技术 <span class="cv-meta">(in progress)</span></p>
            <ul class="cv-bullets">
              <li>相关课程：程序设计实习、人工智能基础.</li>
            </ul>
          </li>
        </ul>
      </section>

      <!-- Honors & Awards -->
      <section>
        <h2 class="section-heading"><span class="section-num">III.</span>Honors &amp; Awards</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">团体第四名 · 五禽戏项目</span>
              <span class="cv-date">2026 Spring</span>
            </div>
            <p class="cv-sub">首都高校健身气功比赛 · 代表北京大学导引队参赛</p>
          </li>
        </ul>
      </section>

      <!-- Selected Projects & Research -->
      <section>
        <h2 class="section-heading"><span class="section-num">IV.</span>Selected Projects &amp; Research</h2>
        <ul class="cv-list">

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/ruguo0119/dog-emotion-recognition" target="_blank" rel="noopener noreferrer" class="cv-link">Dog Emotion Recognition</a></span>
              <span class="cv-date">2026 —</span>
            </div>
            <p class="cv-sub">Research · Python · PyTorch <span class="cv-meta">— Peking University Innovation + Workstation</span></p>
            <ul class="cv-bullets">
              <li>基于姿态与声纹特征对犬类意图进行多模态识别.</li>
              <li>已通过开题答辩, 项目持续推进中.</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/PKU-Planner" target="_blank" rel="noopener noreferrer" class="cv-link">PKU-Planner</a></span>
              <span class="cv-date">2025</span>
            </div>
            <p class="cv-sub">Software · C++ · Qt <span class="cv-meta">— Independent</span></p>
            <ul class="cv-bullets">
              <li>面向北京大学教学网的课程与 DDL 桌面助手, 支持教学网导入与截图识别课程.</li>
              <li>以视觉驱动的紧迫度提示展示任务; 集成一键 AI 个性化建议.</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/Obsidian-to-Hexo" target="_blank" rel="noopener noreferrer" class="cv-link">Obsidian-to-Hexo</a></span>
              <span class="cv-date">2025</span>
            </div>
            <p class="cv-sub">Tooling · Python <span class="cv-meta">— Independent</span></p>
            <ul class="cv-bullets">
              <li>将 Obsidian 笔记迁移至 Hexo 博客的自动化工具.</li>
              <li>解析 Obsidian 特有 Markdown 语法, 整理 frontmatter 并写入 Hexo posts 目录, 支持批量备份与发布.</li>
            </ul>
          </li>

        </ul>
      </section>

      <!-- Technical Skills -->
      <section>
        <h2 class="section-heading"><span class="section-num">V.</span>Technical Skills</h2>
        <dl class="cv-skills">
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Languages</dt>
            <dd>C++, Python</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Frameworks</dt>
            <dd>PyTorch</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">GPU &amp; Compilers</dt>
            <dd>CUDA, Triton, TileLang <span class="cv-meta">(beginner)</span></dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Tools</dt>
            <dd>Git / GitHub, LaTeX, Markdown, Linux</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Languages <span class="cv-meta">(spoken)</span></dt>
            <dd>Chinese (native), English (working)</dd>
          </div>
        </dl>
      </section>

      <!-- Service & Activities -->
      <section>
        <h2 class="section-heading"><span class="section-num">VI.</span>Service &amp; Activities</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">北京大学导引队</span>
              <span class="cv-date">2025.09 — Present</span>
            </div>
            <p class="cv-sub">Member · 五禽戏项目代表队员</p>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">Piano Performance</span>
              <span class="cv-date">ongoing</span>
            </div>
            <p class="cv-sub">Repertoire includes Chopin Ballade No. 1, Chopin Grande Polonaise Brillante, Liszt Rigoletto Paraphrase, Liszt Chasse-neige.</p>
          </li>
        </ul>
      </section>

    </div>

    <footer class="mt-12 pt-4 border-t border-slate-200 dark:border-slate-800 font-sans text-[10px] uppercase tracking-[0.16em] text-slate-400 dark:text-slate-600 flex justify-between flex-wrap gap-2">
      <span>Last updated Sep 2026</span>
      <span>Beijing, China</span>
    </footer>

  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .section-heading {
    @apply font-sans text-[11px] font-semibold uppercase tracking-[0.22em] text-slate-700 dark:text-slate-300 pb-1.5 mb-3 border-b border-slate-300 dark:border-slate-700 flex items-baseline gap-3;
  }
  .section-num {
    @apply font-mono text-[10px] tracking-normal text-slate-400 dark:text-slate-500 normal-case;
  }
  .cv-list {
    @apply space-y-5;
  }
  .cv-entry {
    @apply text-[15px];
  }
  .cv-head {
    @apply flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1;
  }
  .cv-title {
    @apply font-medium text-slate-900 dark:text-slate-100;
  }
  .cv-date {
    @apply font-mono text-[11px] tracking-tight text-slate-500 dark:text-slate-500 tabular-nums shrink-0;
  }
  .cv-sub {
    @apply italic text-slate-600 dark:text-slate-400 mt-0.5 text-[14px];
  }
  .cv-meta {
    @apply not-italic text-slate-500 dark:text-slate-500;
  }
  .cv-bullets {
    @apply mt-1.5 space-y-0.5 text-slate-700 dark:text-slate-300 text-[14px] pl-5 list-outside list-disc marker:text-slate-400 dark:marker:text-slate-600;
  }
  .cv-link {
    @apply hover:underline underline-offset-4 decoration-slate-400 dark:decoration-slate-600;
  }
  .cv-skills {
    @apply text-[14px];
  }
  .cv-skill-row {
    @apply grid grid-cols-[8rem_1fr] gap-x-4 py-1 border-b border-dashed border-slate-200 dark:border-slate-800;
  }
  .cv-skill-row:last-child {
    @apply border-b-0;
  }
  .cv-skill-key {
    @apply font-sans text-[11px] uppercase tracking-[0.16em] text-slate-500 dark:text-slate-500 self-baseline pt-0.5;
  }
</style>
