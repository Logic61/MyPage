---
import Layout from '../layouts/Layout.astro';
import CvHeader from '../components/CvHeader.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import StudyPrelude from '../components/StudyPrelude.astro';

---

<Layout title="陈冠宇 - Curriculum Vitae" section="cv">
  <div class="site-shell section-shell cv-shell">

    <Navigation />

    <main id="main-content" class="site-content cv-page">
    <StudyPrelude title="主人小笺" eyebrow="山中书斋 · 关于我" seal="笺"
      description="几行近况，一纸履历。认识一下这间书斋的主人。" />
    <article class="cv-document" aria-labelledby="cv-name">
    <CvHeader isEn={false} />

    <div class="cv-sections">

      <!-- 研究兴趣 -->
      <section>
        <h2 class="section-heading">研究兴趣</h2>
        <p class="cv-note">
          目前正在探索流式视频理解。
        </p>
      </section>

      <!-- 教育背景 -->
      <section>
        <h2 class="section-heading">教育背景</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">厦门外国语学校</span>
              <span class="cv-date">2022.09 - 2025.06</span>
            </div>
            <p class="cv-sub">高中</p>
            <ul class="cv-bullets">
              <li>第 40 届、41 届全国中学生物理竞赛（CPHO）省一等奖.</li>
            </ul>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">北京大学</span>
              <span class="cv-date">2025.09 - 至今</span>
            </div>
            <p class="cv-sub">信息科学技术学院 · 本科 · 计算机科学与技术</p>
            <ul class="cv-bullets">
              <li>2026秋三好学生</li>
            </ul>
          </li>
        </ul>
      </section>

      <!-- 项目与研究 -->
      <section>
        <h2 class="section-heading">项目与研究</h2>
        <ul class="cv-list">

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/ruguo0119/dog-emotion-recognition" target="_blank" rel="noopener noreferrer" class="cv-link">犬类情绪识别</a></span>
              <span class="cv-date">2026 -</span>
            </div>
            <p class="cv-sub">研究项目 · Python · PyTorch <span class="cv-meta">- 北京大学创新+工作站</span></p>
            <ul class="cv-bullets">
              <li>基于姿态与声纹特征对犬类意图进行多模态识别.</li>
              <li>已通过开题答辩，项目持续推进中.</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/pku-campus-skill" target="_blank" rel="noopener noreferrer" class="cv-link">燕园一处 · AWE PKU</a></span>
              <span class="cv-date">2026</span>
            </div>
            <p class="cv-sub">校园信息检索 · Python · MCP</p>
            <ul class="cv-bullets">
              <li>开发本机运行的北大校园信息技能，统一检索教学网作业、公告、课表、树洞和校园活动。</li>
              <li>实现树洞评论分页和日报采集核验，供网页工作台、CLI、MCP 和 HTTP 接口共用。</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/SurfSoul" target="_blank" rel="noopener noreferrer" class="cv-link">SurfSoul</a></span>
              <span class="cv-date">2026</span>
            </div>
            <p class="cv-sub">AI 陪伴 · JavaScript <span class="cv-meta">- 基于 SurfCore 的衍生项目</span></p>
            <ul class="cv-bullets">
              <li>构建分层记忆，整合叙事、自我记录和文档，支持按需召回带出处的原文。</li>
              <li>实现桌宠的共享屏幕陪伴，可在对话中按需看屏幕，也能根据当前活动判断何时适合主动搭话。</li>
            </ul>
          </li>

        </ul>
      </section>

      <!-- 技术能力 -->
      <section>
        <h2 class="section-heading">技术能力</h2>
        <dl class="cv-skills">
          <div class="cv-skill-row">
            <dt class="cv-skill-key">编程语言</dt>
            <dd>C++、Python</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">框架</dt>
            <dd>PyTorch</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">GPU 与编译器</dt>
            <dd>CUDA、Triton、TileLang <span class="cv-meta">（入门）</span></dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">工具</dt>
            <dd>Git / GitHub、LaTeX、Markdown</dd>
          </div>
        </dl>
      </section>

      <!-- 业余兴趣 -->
      <section>
        <h2 class="section-heading">业余兴趣</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">北京大学导引队</span>
              <span class="cv-date">2025.09 - 至今</span>
            </div>
            <p class="cv-sub">队员 · 五禽戏项目代表</p>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">团体第四名 · 五禽戏项目</span>
              <span class="cv-date">2026 春</span>
            </div>
            <p class="cv-sub">首都高校健身气功比赛 · 代表北京大学参赛</p>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">钢琴演奏</span>
              <span class="cv-date">持续中</span>
            </div>
            <p class="cv-sub">北京大学钢琴社演奏部成员.</p>
          </li>
        </ul>
      </section>

    </div>

    <footer class="cv-footer">
      <span>最后更新 2026 年 11 月</span>
      <span>中国 · 北京</span>
    </footer>

    </article>
  </main>
  <Footer />
  </div>
</Layout>
