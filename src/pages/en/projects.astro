---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { Icon } from 'astro-icon/components';


const projects = [
  {
    name: "AWE PKU",
    stack: "Python · MCP",
    desc: "A locally run agent skill for finding Peking University campus information.",
    points: [
      "Searches assignments, announcements, and timetables, and checks campus events against their original listings.",
      "Filters Treehole posts by comment count, reads comments page by page, and checks the coverage of daily digests.",
      "Shares local connectors across the web workspace, CLI, MCP, and HTTP API."
    ],
    github: "https://github.com/Logic61/pku-campus-skill"
  },
  {
    name: "SurfSoul",
    stack: "JavaScript",
    desc: "A SurfCore fork that brings an AI companion to QQ, Bilibili, and a desktop pet.",
    points: [
      "Layered memory turns past interactions into editable narratives, combines them with self-notes and documents, and retrieves source passages with citations on demand.",
      "The desktop pet can look at the shared screen during a chat. It uses the same rules as the QQ companion to decide when on-screen activity leaves room for a conversation.",
      "Generates numbered storyboards for Bilibili videos, with timestamps and dialogue for each panel."
    ],
    github: "https://github.com/Logic61/SurfSoul"
  },
  {
    name: "PKU Planner",
    stack: "C++ · Qt",
    desc: "A desktop app for Peking University students to manage courses and deadlines.",
    points: [
      "Syncs timetables and deadlines from the teaching portal and extracts course details from timetable screenshots.",
      "Color-codes timetable cells by the nearest deadline and shows pending tasks on hover.",
      "Generates personalized AI study suggestions from the timetable and upcoming deadlines."
    ],
    github: "https://github.com/Logic61/PKU-Planner"
  }
];
---
<Layout title="Projects - Shane Lorien">
  <div class="site-shell">
    <Navigation />
    <main id="main-content" class="site-content">
      <header class="page-heading">
        <h1>Projects</h1>
        <p>Selected open-source repositories and academic experiments.</p>
      </header>
      <div class="project-list">
        {projects.map(proj => (
          <section class="project">
            <div>
              <div class="project-title">
                <h2>{proj.name}</h2>
                <a class="icon-button" href={proj.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${proj.name}`}><Icon name="mdi:arrow-top-right" /></a>
              </div>
              <p>{proj.desc}</p>
              <div class="project-stack">{proj.stack}</div>
            </div>
            <ul>{proj.points.map(point => <li>{point}</li>)}</ul>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
