---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { Icon } from 'astro-icon/components';


const projects = [
  {
    name: "AmazonChess",
    stack: "C++",
    desc: "PKU Intro to CS Fall 2025 Final Project: Game of the Amazons",
    points: [
      "Implemented fundamental board logic, legal move validation, and obstacle detection",
      "Built the core game logic and decision framework purely in C++",
      "Maintained well-organized project structure and clean codebase"
    ],
    github: "https://github.com/Logic61/AmazonChess"
  },
  {
    name: "Obsidian-to-Hexo",
    stack: "Python",
    desc: "Automation tool for migrating Obsidian Markdown documents to Hexo blog",
    points: [
      "Parsed and converted Obsidian-specific syntax in Markdown files",
      "Automatically structured files for Hexo's posts directory and managed frontmatter",
      "Written in Python to enable seamless batch backup and publishing workflow"
    ],
    github: "https://github.com/Logic61/Obsidian-to-Hexo"
  },
  {
    name: "Carnival-game-suite",
    stack: "JavaScript",
    desc: "A collection of web-based mini carnival games",
    points: [
      "Built fully interactive web front-end logic using pure JavaScript",
      "Implemented basic probability mechanics, event listeners, and UI feedback",
      "Developed as a hands-on project to practice front-end componentization"
    ],
    github: "https://github.com/Logic61/Carnival-game-suite"
  }
];
---
<Layout title="Projects - Shane Lorien">
  <div class="site-shell">
    <Navigation />
    <main id="main-content" class="site-content">
      <header class="page-heading">
        <h1>Projects</h1>
        <p>Selected open-source repositories and academic experiments.</p>
      </header>
      <div class="project-list">
        {projects.map(proj => (
          <section class="project">
            <div>
              <div class="project-title">
                <h2>{proj.name}</h2>
                <a class="icon-button" href={proj.github} target="_blank" rel="noopener noreferrer" aria-label={`GitHub: ${proj.name}`}><Icon name="mdi:arrow-top-right" /></a>
              </div>
              <p>{proj.desc}</p>
              <div class="project-stack">{proj.stack}</div>
            </div>
            <ul>{proj.points.map(point => <li>{point}</li>)}</ul>
          </section>
        ))}
      </div>
    </main>
    <Footer />
  </div>
</Layout>
