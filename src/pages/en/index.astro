---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';

const entries = [
  { href: "/MyPage/en/blog", label: "Blog", note: "notes on math and computer science" },
  { href: "/MyPage/en/cv", label: "CV", note: "education and projects" },
  { href: "/MyPage/en/projects", label: "Projects", note: "open-source repositories" },
];
---

<Layout title="Shane Lorien">
  <main class="relative max-w-3xl mx-auto px-6 sm:px-8 pt-10 sm:pt-12 pb-8 text-stone-900 dark:text-stone-100 transition-colors duration-300 min-h-[100dvh] flex flex-col">

    <Navigation />

    <!-- 竖排《天问》装饰 -->
    <p aria-hidden="true" class="hidden xl:block absolute right-0 top-1/2 -translate-y-1/2 font-serif text-sm tracking-[0.4em] text-stone-300 dark:text-stone-700 select-none [writing-mode:vertical-rl]">日月安属，列星安陈。</p>

    <header class="flex-1 flex flex-col justify-center">
      <span class="rise block w-3 h-3 bg-accent dark:bg-accent-dark mb-8" aria-hidden="true"></span>
      <h1 class="rise font-serif font-medium text-6xl sm:text-7xl tracking-tight text-stone-900 dark:text-stone-50" style="animation-delay: 60ms">
        Shane Lorien
      </h1>
      <p class="rise mt-6 font-serif text-stone-500 dark:text-stone-400" style="animation-delay: 120ms">
        Peking University · B.E. Computer Science, since 2025
      </p>
      <p class="rise mt-4 max-w-md font-serif text-stone-600 dark:text-stone-400 leading-relaxed" style="animation-delay: 180ms">
        Writing notes on math and computer science, and building small tools along the way.
      </p>

      <nav class="rise mt-14 border-b border-stone-200 dark:border-stone-800" style="animation-delay: 240ms">
        {entries.map(e => (
          <a href={e.href} class="group flex items-baseline gap-4 py-4 border-t border-stone-200 dark:border-stone-800 transition-all hover:pl-2">
            <span class="font-serif text-2xl text-stone-800 dark:text-stone-200 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">{e.label}</span>
            <span class="flex-1 text-sm text-stone-400 dark:text-stone-500">{e.note}</span>
            <span aria-hidden="true" class="text-accent dark:text-accent-dark opacity-0 group-hover:opacity-100 transition-opacity">→</span>
          </a>
        ))}
      </nav>
    </header>

    <Footer />

  </main>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      opacity: 0;
      transform: translateY(8px);
      animation: rise 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes rise {
      to { opacity: 1; transform: none; }
    }
  }
</style>
