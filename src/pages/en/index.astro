---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Guanyu Chen">
  <main class="max-w-3xl mx-auto px-6 sm:px-8 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300 min-h-screen flex flex-col">

    <!-- Hero: centered, single-weight display, avatar above the type -->
    <header class="flex-1 flex flex-col items-center justify-center text-center pt-24 pb-20">
      <img
        src="/MyPage/avatar.jpg"
        alt=""
        width="96"
        height="96"
        loading="eager"
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover mb-12 sm:mb-16"
      />
      <h1 class="font-serif italic font-light text-[clamp(3.5rem,11vw,8rem)] leading-[0.95] tracking-[-0.035em] text-slate-900 dark:text-slate-50">
        Guanyu Chen
      </h1>
      <div class="mt-8 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500">
        <span class="block w-8 h-px bg-slate-300 dark:bg-slate-700"></span>
        <span>日月安属 · 列星安陈</span>
        <span class="block w-8 h-px bg-slate-300 dark:bg-slate-700"></span>
      </div>

      <!-- Start: single entry point to the blog -->
      <a href="/MyPage/en/blog" class="group mt-14 sm:mt-16 inline-flex items-baseline gap-3 font-serif italic text-2xl sm:text-3xl text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100 transition-colors">
        <span>Start</span>
        <span aria-hidden="true" class="font-sans not-italic text-xl transition-transform group-hover:translate-x-1.5">→</span>
      </a>
    </header>

  </main>
</Layout>
