---
import Layout from '../../layouts/Layout.astro';
import CvHeader from '../../components/CvHeader.astro';
import Navigation from '../../components/Navigation.astro';

---

<Layout title="Guanyu Chen - Curriculum Vitae">
  <div class="site-shell">

    <Navigation />

    <main id="main-content" class="site-content cv-document">
    <CvHeader isEn={true} />

    <div class="cv-sections">

      <!-- Exploring -->
      <section>
        <h2 class="section-heading">Research Interests</h2>
        <p class="cv-note">
          Currently exploring.
        </p>
      </section>

      <!-- Education -->
      <section>
        <h2 class="section-heading">Education</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">Xiamen Foreign Language School</span>
              <span class="cv-date">2022.09 - 2025.06</span>
            </div>
            <p class="cv-sub">High School</p>
            <ul class="cv-bullets">
              <li>Provincial First Prize, 40th and 41st Chinese Physics Olympiad (CPHO).</li>
            </ul>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">Peking University</span>
              <span class="cv-date">2025.09 - Present</span>
            </div>
            <p class="cv-sub">School of Information Science and Technology · B.E. Computer Science and Technology</p>
            <ul class="cv-bullets">
              <li>Three-Good Student, Fall 2026.</li>
            </ul>
          </li>
        </ul>
      </section>

      <!-- Selected Projects & Research -->
      <section>
        <h2 class="section-heading">Selected Projects &amp; Research</h2>
        <ul class="cv-list">

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/ruguo0119/dog-emotion-recognition" target="_blank" rel="noopener noreferrer" class="cv-link">Dog Emotion Recognition</a></span>
              <span class="cv-date">2026 -</span>
            </div>
            <p class="cv-sub">Research · Python · PyTorch <span class="cv-meta">- Peking University Innovation + Workstation</span></p>
            <ul class="cv-bullets">
              <li>Multimodal recognition of canine intent from postural and vocal features.</li>
              <li>Proposal defence passed; project ongoing.</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/PKU-Planner" target="_blank" rel="noopener noreferrer" class="cv-link">PKU-Planner</a></span>
              <span class="cv-date">2025</span>
            </div>
            <p class="cv-sub">Software · C++ · Qt <span class="cv-meta">- Independent</span></p>
            <ul class="cv-bullets">
              <li>Desktop assistant for course and deadline tracking, tailored to the Peking University teaching portal; supports portal import and screenshot-based course recognition.</li>
              <li>Visual urgency indication drives task presentation; integrates one-click AI-generated personalised suggestions.</li>
            </ul>
          </li>

          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title"><a href="https://github.com/Logic61/Obsidian-to-Hexo" target="_blank" rel="noopener noreferrer" class="cv-link">Obsidian-to-Hexo</a></span>
              <span class="cv-date">2025</span>
            </div>
            <p class="cv-sub">Tooling · Python <span class="cv-meta">- Independent</span></p>
            <ul class="cv-bullets">
              <li>Automation tool for migrating Obsidian Markdown notes to a Hexo blog.</li>
              <li>Parses Obsidian-specific Markdown syntax, normalises frontmatter, and writes to Hexo's posts directory; supports batch backup and publishing.</li>
            </ul>
          </li>

        </ul>
      </section>

      <!-- Technical Skills -->
      <section>
        <h2 class="section-heading">Technical Skills</h2>
        <dl class="cv-skills">
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Languages</dt>
            <dd>C++, Python</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Frameworks</dt>
            <dd>PyTorch</dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">GPU &amp; Compilers</dt>
            <dd>CUDA, Triton, TileLang <span class="cv-meta">(beginner)</span></dd>
          </div>
          <div class="cv-skill-row">
            <dt class="cv-skill-key">Tools</dt>
            <dd>Git / GitHub, LaTeX, Markdown</dd>
          </div>
        </dl>
      </section>

      <!-- Hobbies -->
      <section>
        <h2 class="section-heading">Hobbies</h2>
        <ul class="cv-list">
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">Peking University Daoyin Team</span>
              <span class="cv-date">2025.09 - Present</span>
            </div>
            <p class="cv-sub">Member · Wu Qin Xi event representative</p>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">4th Place · Wu Qin Xi Event</span>
              <span class="cv-date">2026 Spring</span>
            </div>
            <p class="cv-sub">Capital Universities Fitness Qigong Competition · representing Peking University</p>
          </li>
          <li class="cv-entry">
            <div class="cv-head">
              <span class="cv-title">Piano Performance</span>
              <span class="cv-date">ongoing</span>
            </div>
            <p class="cv-sub">Member of the Peking University Piano Club, Performance Division.</p>
          </li>
        </ul>
      </section>

    </div>

    <footer class="cv-footer">
      <span>Last updated Sep 2026</span>
      <span>Beijing, China</span>
    </footer>

  </main>
  </div>
</Layout>
