---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft).catch(() => []);
const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
---

<Layout title="Notes - Guanyu Chen">
  <main class="max-w-6xl mx-auto px-6 sm:px-10 py-12 sm:py-16 bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 leading-relaxed min-h-screen transition-colors duration-300">

    <Navigation />

    <header class="pt-10 pb-12 sm:pb-14">
      <h1 class="font-serif text-6xl sm:text-7xl font-light tracking-[-0.04em] leading-[0.9] text-slate-900 dark:text-slate-50">
        <span class="italic">Blogs</span>
      </h1>
      <p class="mt-6 font-mono text-xs uppercase tracking-[0.22em] text-slate-400 dark:text-slate-500 tabular-nums">
        <span>{posts.length}</span> entries
        <span class="text-slate-300 dark:text-slate-700 mx-2">·</span>
        <span>{categories.length}</span> categories
        <span class="text-slate-300 dark:text-slate-700 mx-2">·</span>
        since <span>2025</span>
      </p>

      {categories.length > 0 && (
        <nav class="mt-8 flex flex-wrap items-baseline gap-x-1.5 gap-y-1 font-mono text-[11px] uppercase tracking-[0.18em]" id="category-filter">
          <span class="category-btn cursor-pointer transition-colors text-slate-900 dark:text-slate-100" data-target="all">All</span>
          {categories.map(cat => (
            <>
              <span class="text-slate-200 dark:text-slate-800">/</span>
              <span class="category-btn cursor-pointer transition-colors text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-slate-100" data-target={cat}>{cat}</span>
            </>
          ))}
        </nav>
      )}
    </header>

    <ol id="post-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {posts.map((post) => {
        const d = new Date(post.data.pubDate);
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const yyyy = d.getFullYear();
        return (
          <li class="post-item" data-category={post.data.category || ''}>
            <a href={`/MyPage/en/blog/${post.id}`} class="group flex flex-col h-full p-6 sm:p-7 border border-slate-100 dark:border-slate-900 rounded-lg bg-white dark:bg-slate-950 hover:border-slate-300 dark:hover:border-slate-700 hover:shadow-[0_2px_24px_-12px_rgba(15,23,42,0.12)] dark:hover:shadow-[0_2px_24px_-12px_rgba(0,0,0,0.5)] transition-all">

              <div class="flex items-center justify-between gap-3 mb-5">
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500 dark:text-slate-500 truncate">
                  {post.data.category}
                </span>
                <time class="font-mono text-[10px] uppercase tracking-[0.14em] text-slate-400 dark:text-slate-600 tabular-nums shrink-0" datetime={post.data.pubDate}>
                  {yyyy}·{mm}·{dd}
                </time>
              </div>

              <h3 class="font-sans font-semibold text-base sm:text-lg text-slate-900 dark:text-slate-100 group-hover:text-slate-700 dark:group-hover:text-slate-200 leading-snug transition-colors">
                {post.data.title}
              </h3>

              {post.data.description && (
                <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 line-clamp-3 leading-relaxed flex-1">
                  {post.data.description}
                </p>
              )}

              {post.data.tags && post.data.tags.length > 0 && (
                <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-900 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[10px] text-slate-400 dark:text-slate-500">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span>#{tag}</span>
                  ))}
                </div>
              )}

            </a>
          </li>
        );
      })}
    </ol>

    <nav id="pagination" class="mt-16 pt-8 border-t border-slate-100 dark:border-slate-900 flex items-center justify-center gap-5 font-mono text-slate-400 dark:text-slate-500">
      <button id="prev-page" class="text-xl hover:text-slate-900 dark:hover:text-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled>
        ‹
      </button>
      <div class="flex items-center gap-2 tabular-nums text-xs uppercase tracking-[0.18em]">
        <input id="page-input" type="text" value="1" class="w-8 text-center bg-transparent border-b border-transparent hover:border-slate-200 focus:border-slate-900 dark:focus:border-slate-100 focus:outline-none text-slate-900 dark:text-slate-100 transition-colors py-0.5" />
        <span class="text-slate-300 dark:text-slate-700">/</span>
        <span id="page-total">1</span>
      </div>
      <button id="next-page" class="text-xl hover:text-slate-900 dark:hover:text-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled>
        ›
      </button>
    </nav>

  </main>
</Layout>

<script>
  const POSTS_PER_PAGE = 6;
  const postElements = Array.from(document.querySelectorAll('.post-item')) as HTMLElement[];
  const buttons = document.querySelectorAll('.category-btn');
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement | null;
  const pageInput = document.getElementById('page-input') as HTMLInputElement | null;
  const pageTotalEl = document.getElementById('page-total');
  const paginationEl = document.getElementById('pagination');

  let currentPage = 1;
  let currentCategory = 'all';

  function renderPosts() {
    const filtered = postElements.filter(post =>
      currentCategory === 'all' || (post as HTMLElement).dataset.category === currentCategory
    );

    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    postElements.forEach(post => post.style.display = 'none');

    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    filtered.slice(start, end).forEach(post => post.style.display = '');

    if (pageInput) pageInput.value = String(currentPage);
    if (pageTotalEl) pageTotalEl.textContent = String(totalPages);
    if (paginationEl) paginationEl.style.display = totalPages > 1 ? '' : 'none';

    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove('text-slate-900', 'dark:text-slate-100');
        b.classList.add('text-slate-400', 'dark:text-slate-500', 'hover:text-slate-900', 'dark:hover:text-slate-100');
      });
      btn.classList.remove('text-slate-400', 'dark:text-slate-500', 'hover:text-slate-900', 'dark:hover:text-slate-100');
      btn.classList.add('text-slate-900', 'dark:text-slate-100');

      currentCategory = btn.getAttribute('data-target') || 'all';
      currentPage = 1;
      renderPosts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; renderPosts(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  nextBtn?.addEventListener('click', () => {
    if (currentPage < parseInt(pageTotalEl?.textContent || '1')) {
      currentPage++;
      renderPosts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  pageInput?.addEventListener('change', e => {
    const val = parseInt((e.target as HTMLInputElement).value);
    const filtered = postElements.filter(p =>
      currentCategory === 'all' || (p as HTMLElement).dataset.category === currentCategory
    );
    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    if (!isNaN(val) && val >= 1 && val <= totalPages) {
      currentPage = val;
      renderPosts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      (e.target as HTMLInputElement).value = String(currentPage);
    }
  });

  renderPosts();
</script>
