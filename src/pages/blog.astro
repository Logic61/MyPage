---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft).catch(() => []);
const posts = allPosts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
---

<Layout title="博客 - Shane Lorien">
  <main class="max-w-4xl mx-auto px-6 sm:px-10 py-10 sm:py-12 text-stone-900 dark:text-stone-100 leading-relaxed min-h-[100dvh] flex flex-col transition-colors duration-300">

    <Navigation />

    <header class="pb-10 sm:pb-12">
      <h1 class="font-serif font-medium text-5xl sm:text-6xl tracking-tight text-stone-900 dark:text-stone-50">
        博客
      </h1>
      <p class="mt-4 font-serif text-sm text-stone-400 dark:text-stone-500">
        共 {posts.length} 篇 · {categories.length} 个分类
      </p>

      {categories.length > 0 && (
        <nav class="mt-8 flex flex-wrap items-baseline gap-x-2 gap-y-2 font-serif text-[15px]" id="category-filter">
          <span class="category-btn cursor-pointer transition-colors text-accent dark:text-accent-dark font-semibold" data-target="all">全部</span>
          {categories.map(cat => (
            <>
              <span class="text-stone-300 dark:text-stone-700">/</span>
              <span class="category-btn cursor-pointer transition-colors text-stone-400 dark:text-stone-500 hover:text-stone-900 dark:hover:text-stone-100" data-target={cat}>{cat}</span>
            </>
          ))}
        </nav>
      )}
    </header>

    <!-- 编号索引行: 序号 / 标题+摘要 / 分类 / 日期 -->
    <ol id="post-list" class="border-b border-stone-200 dark:border-stone-800">
      {posts.map((post, i) => {
        const d = new Date(post.data.pubDate);
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        const yyyy = d.getFullYear();
        return (
          <li class="post-item" data-category={post.data.category || ''}>
            <a href={`/MyPage/blog/${post.id}`} class="group flex items-baseline gap-x-5 py-5 border-t border-stone-200 dark:border-stone-800 transition-all hover:pl-2">

              <span class="font-serif text-sm text-stone-300 dark:text-stone-600 tabular-nums shrink-0 w-7 text-right select-none">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="flex-1 min-w-0">
                <h3 class="font-serif font-semibold text-xl text-stone-900 dark:text-stone-100 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="mt-1 font-serif text-[15px] text-stone-500 dark:text-stone-400 line-clamp-1">
                    {post.data.description}
                  </p>
                )}
              </div>

              <span class="font-serif text-sm text-stone-400 dark:text-stone-500 shrink-0 hidden md:block">
                {post.data.category}
              </span>

              <time class="font-serif text-sm text-stone-400 dark:text-stone-600 tabular-nums shrink-0 w-24 text-right hidden sm:block" datetime={post.data.pubDate}>
                {yyyy}.{mm}.{dd}
              </time>

            </a>
          </li>
        );
      })}
    </ol>

    <!-- Pagination -->
    <nav id="pagination" class="mt-12 flex items-center justify-center gap-5 font-serif text-stone-400 dark:text-stone-500">
      <button id="prev-page" class="text-xl hover:text-accent dark:hover:text-accent-dark transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled>
        ‹
      </button>
      <div class="flex items-center gap-2 tabular-nums text-sm">
        <input id="page-input" type="text" value="1" class="w-8 text-center bg-transparent border-b border-transparent hover:border-stone-300 focus:border-stone-900 dark:focus:border-stone-100 focus:outline-none text-stone-900 dark:text-stone-100 transition-colors py-0.5" />
        <span class="text-stone-300 dark:text-stone-700">/</span>
        <span id="page-total">1</span>
      </div>
      <button id="next-page" class="text-xl hover:text-accent dark:hover:text-accent-dark transition-colors disabled:opacity-30 disabled:cursor-not-allowed" disabled>
        ›
      </button>
    </nav>

    <Footer />

  </main>
</Layout>

<script>
  const POSTS_PER_PAGE = 10;
  const postElements = Array.from(document.querySelectorAll('.post-item')) as HTMLElement[];
  const buttons = document.querySelectorAll('.category-btn');
  const prevBtn = document.getElementById('prev-page') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('next-page') as HTMLButtonElement | null;
  const pageInput = document.getElementById('page-input') as HTMLInputElement | null;
  const pageTotalEl = document.getElementById('page-total');
  const paginationEl = document.getElementById('pagination');

  let currentPage = 1;
  let currentCategory = 'all';

  function renderPosts() {
    const filtered = postElements.filter(post =>
      currentCategory === 'all' || (post as HTMLElement).dataset.category === currentCategory
    );

    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    postElements.forEach(post => post.style.display = 'none');

    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    filtered.slice(start, end).forEach(post => post.style.display = '');

    if (pageInput) pageInput.value = String(currentPage);
    if (pageTotalEl) pageTotalEl.textContent = String(totalPages);
    if (paginationEl) paginationEl.style.display = totalPages > 1 ? '' : 'none';

    if (prevBtn) prevBtn.disabled = currentPage <= 1;
    if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
  }

  const ACTIVE = ['text-accent', 'dark:text-accent-dark', 'font-semibold'];
  const INACTIVE = ['text-stone-400', 'dark:text-stone-500', 'hover:text-stone-900', 'dark:hover:text-stone-100'];

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => {
        b.classList.remove(...ACTIVE);
        b.classList.add(...INACTIVE);
      });
      btn.classList.remove(...INACTIVE);
      btn.classList.add(...ACTIVE);

      currentCategory = btn.getAttribute('data-target') || 'all';
      currentPage = 1;
      renderPosts();
    });
  });

  prevBtn?.addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; renderPosts(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  nextBtn?.addEventListener('click', () => {
    if (currentPage < parseInt(pageTotalEl?.textContent || '1')) {
      currentPage++;
      renderPosts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  pageInput?.addEventListener('change', e => {
    const val = parseInt((e.target as HTMLInputElement).value);
    const filtered = postElements.filter(p =>
      currentCategory === 'all' || (p as HTMLElement).dataset.category === currentCategory
    );
    const totalPages = Math.max(1, Math.ceil(filtered.length / POSTS_PER_PAGE));
    if (!isNaN(val) && val >= 1 && val <= totalPages) {
      currentPage = val;
      renderPosts();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } else {
      (e.target as HTMLInputElement).value = String(currentPage);
    }
  });

  renderPosts();
</script>
