---
import { getImage } from 'astro:assets';
import InkLandscape from './InkLandscape.astro';
import landscape from '../assets/home-cloudscape.webp';
import mist from '../assets/drifting-mist.webp';

const portrait = await getImage({
  src: landscape, width: 740, height: 888, fit: 'cover', position: 'right', format: 'webp', quality: 84,
});
---
<InkLandscape mistSrc={mist.src}>
  <picture class="home-cloudscape">
    <source media="(max-width: 760px) and (orientation: portrait)" srcset={portrait.src} width="740" height="888" />
    <img src={landscape.src} width={landscape.width} height={landscape.height} alt="" fetchpriority="high" decoding="async" />
  </picture>
</InkLandscape>
