---
import { Icon } from 'astro-icon/components';
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="cv-header">
  <div>
    <h1>{isEn ? 'Guanyu Chen' : '陈冠宇'}</h1>
    <p class="cv-identity">{isEn ? 'Peking University · B.E. Computer Science, since 2025' : '北京大学 · 计算机科学与技术，2025级'}</p>
    <div class="cv-contact">
      <a href="mailto:logic.dreemurr@gmail.com"><Icon name="mdi:email-outline" />logic.dreemurr@gmail.com</a>
      <a href="https://github.com/logic61" target="_blank" rel="noopener noreferrer"><Icon name="mdi:github" />github.com/logic61</a>
    </div>
  </div>
  <a href={`${base}/cv.pdf`} download class="button cv-download"><Icon name="mdi:download" />{isEn ? 'Download PDF' : '下载 PDF'}</a>
</header>
