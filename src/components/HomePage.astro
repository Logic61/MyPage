---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import StudyCatalogue from './StudyCatalogue.astro';
import '../styles/retreat.css';
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}${isEn ? '/en' : ''}`;
const stateKey = `shane-retreat:${base}`;
// Image and links share the complete 1672 × 941 canvas on every screen.
const objects = [
  { id: 'books', x: 25.6, y: 55.2, w: 14.7, h: 16.5, label: isEn ? 'Blog' : '博客', detail: isEn ? 'Browse all posts' : '阅读全部文章', href: `${prefix}/blog`, view: 'all' },
  { id: 'notebook', x: 48.1, y: 72.1, w: 29.6, h: 16.8, label: isEn ? 'Latest posts' : '最新文章', detail: isEn ? 'The latest eight posts' : '最近更新的八篇文章', href: `${prefix}/blog`, view: 'recent' },
  { id: 'workbench', x: 83.8, y: 47.2, w: 11.3, h: 11.7, label: isEn ? 'Projects' : '项目', detail: isEn ? 'Code and experiments' : '代码与实践', href: `${prefix}/projects` },
  { id: 'letter', x: 77.9, y: 77.4, w: 18.3, h: 11.4, label: isEn ? 'CV' : '简历', detail: isEn ? 'Education and experience' : '经历与研究兴趣', href: `${prefix}/cv` },
];
---
<Layout title={isEn ? 'Shane Lorien · A mountain study' : 'Shane Lorien · 山中书斋'} section="home" spatial>
  <script is:inline define:vars={{ stateKey }}>
    (() => {
      const root = document.documentElement;
      let remembered = 'mountain';
      try { remembered = sessionStorage.getItem(stateKey) || remembered; } catch {}
      root.dataset.retreatScene = location.hash === '#study' ? 'study' : location.hash === '#mountain' ? 'mountain' : remembered === 'study' ? 'study' : 'mountain';
      root.classList.add('retreat-js');
    })();
  </script>
  <div class="retreat" data-retreat data-state-key={stateKey} data-language={isEn ? 'en' : 'zh'}>
    <header class="retreat-chrome"><Navigation /></header>
    <main id="main-content" class="retreat-main">
      <section class="retreat-scene retreat-mountain" id="mountain" data-scene="mountain" aria-labelledby="mountain-title">
        <div class="retreat-image-frame">
          <div class="retreat-canvas" data-scene-canvas>
            <img class="retreat-painting" src={`${base}/scenes/mountain-gate.webp`} width="1672" height="941" alt={isEn ? 'A winding mountain path leads to a warmly lit study beneath the cliffs.' : '青绿山间，一条石径通向崖下亮着暖灯的书斋。'} fetchpriority="high" decoding="async" />
            <a class="retreat-spot retreat-door" href="#study" data-enter-study style="--spot-x:83.2%;--spot-y:76.8%;--spot-width:7%;--spot-height:14.5%" aria-label={isEn ? 'Enter the mountain study' : '推门，进入书斋'} aria-describedby="retreat-enter-help">
              <span class="retreat-door-cue">{isEn ? 'Enter the study' : '进入书斋'}</span>
            </a>
          </div>
          <div class="retreat-atmosphere" aria-hidden="true"></div>
        </div>
        <header class="retreat-introduction">
          <p class="retreat-eyebrow">{isEn ? 'A mountain study' : '山中书斋'}</p>
          <h1 id="mountain-title" tabindex="-1">Shane Lorien</h1>
          <blockquote class="retreat-motto">{isEn ? <><span>What power has the light of night?</span><span>It dies. How is it born again?</span></> : <><span>夜光何德？</span><span>死则又育？</span></>}</blockquote>
          <a class="retreat-enter" href="#study" data-enter-study aria-describedby="retreat-enter-help"><span>{isEn ? 'Enter the study' : '进入书斋'}</span><svg viewBox="0 0 24 28" fill="none" aria-hidden="true"><path d="M5 24V10a7 7 0 0 1 14 0v14M3 24h18M9 24V11l7-2v15M12 17h.01" /></svg></a>
          <p class="retreat-invitation" id="retreat-enter-help">{isEn ? 'Step inside to explore the blog, projects, and CV.' : '点击进入，探索博客、项目与简历。'}</p>
        </header>
        <div class="retreat-scene-note" aria-hidden="true"><span>{isEn ? 'Beyond the clouds' : '云深处'}</span><span class="retreat-note-line"></span><span>{isEn ? 'A light is on' : '灯尚明'}</span></div>
      </section>
      <section class="retreat-scene retreat-study" id="study" data-scene="study" aria-labelledby="study-title">
        <header class="retreat-study-heading"><h2 id="study-title" tabindex="-1">{isEn ? 'The study' : '书斋'}</h2><p>{isEn ? 'Choose an object to explore.' : '点击物件，随意翻阅。'}</p></header>
        <div class="retreat-image-frame">
          <div class="retreat-canvas" data-scene-canvas>
            <img class="retreat-painting" src={`${base}/scenes/cave-study.webp`} width="1672" height="941" alt={isEn ? 'Inside the study: stacked books on the left, an open notebook on the desk, a small workbench and a letter on the right, with mountains beyond the window.' : '书斋内景：左侧堆着书，桌上摊着笔记，右侧是工作台与信笺，窗外仍是远山。'} fetchpriority="low" decoding="async" />
            {objects.map(object => (
              <a class:list={['retreat-spot', `retreat-object-${object.id}`]} href={object.href} style={`--spot-x:${object.x}%;--spot-y:${object.y}%;--spot-width:${object.w}%;--spot-height:${object.h}%`} data-catalogue-open={object.view} data-study-destination={object.id} aria-label={`${object.label} · ${object.detail}`}>
                <span class="retreat-object-title">{object.label}</span>
              </a>
            ))}
          </div>
        </div>
        <nav class="retreat-touch-directory" aria-label={isEn ? 'Study navigation' : '书斋导航'}>
          {objects.map(object => (
            <a href={object.href} data-catalogue-open={object.view} data-study-destination={object.id}><span><strong>{object.label}</strong><small>{object.detail}</small></span></a>
          ))}
        </nav>
        <div class="retreat-study-bottom"><a class="retreat-outside" href="#mountain" data-leave-study>{isEn ? 'Back to the mountains' : '回到山间'}</a><p class="retreat-desktop-hint">{isEn ? 'Books for the blog. A workbench for projects. A letter for the CV.' : '书册里是博客，工作台上是项目，信笺里是简历。'}</p></div>
      </section>
    </main>
    <footer class="retreat-colophon"><p>{isEn ? 'Mathematics, computer science, and reading.' : '数学、计算机，以及阅读中的思考。'}</p><div><span>© {new Date().getFullYear()} Shane Lorien</span><a href={`${prefix}/blog`}>{isEn ? 'All posts' : '全部文章'}</a></div></footer>
    <StudyCatalogue {isEn} />
    <div class="retreat-transition" aria-hidden="true"></div>
  </div>
  <noscript><style is:inline>.retreat-chrome #search-btn,.retreat-chrome #theme-toggle{display:none}</style><p class="retreat-noscript">{isEn ? 'Follow the links in the study to read the blog, explore projects, or view the CV.' : '点击书斋中的物件，即可阅读博客、查看项目或简历。'}</p></noscript>
  <script>import '../scripts/retreat';</script>
</Layout>
