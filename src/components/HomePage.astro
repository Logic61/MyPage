---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import PostRow from './PostRow.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}${isEn ? '/en' : ''}`;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map(post => post.data.category).filter((category): category is string => !!category))];
---
<Layout title="Shane Lorien">
  <div class="site-shell">
    <Navigation />
    <main id="main-content" class="site-content">
      <header class:list={['home-intro', 'book-frontispiece', { 'frontispiece-en': isEn }]}>
        <p class="frontispiece-label">{isEn ? 'Collected notes' : '随笔与札记'}</p>
        <div class="frontispiece-body">
          <div class="frontispiece-title">
            <h1>Shane Lorien</h1>
            <blockquote class="home-motto">
              <p class="frontispiece-quote">{isEn ? 'What virtue the moonlight? Death, then rebirth.' : <><span>夜光何德？</span><span>死则又育？</span></>}</p>
            </blockquote>
            <div class="home-actions">
              <a class="text-link" href={`${prefix}/blog`}>{isEn ? 'Read the blog' : '阅读博客'}<Icon name="mdi:arrow-right" /></a>
              <a class="text-link" href={`${prefix}/projects`}>{isEn ? 'Explore projects' : '查看项目'}<Icon name="mdi:arrow-right" /></a>
            </div>
          </div>
        </div>
        <figure class="frontispiece-author">
          <img src={`${base}/avatar.jpg`} alt={isEn ? 'Shane Lorien’s avatar' : 'Shane Lorien 的头像'} width="144" height="144" class="home-avatar" />
          <figcaption><a class="text-link" href={`${prefix}/cv`}>{isEn ? 'About the author' : '关于作者'}</a></figcaption>
        </figure>
      </header>
      <div class="home-columns">
        <section aria-labelledby="latest-heading">
          <div class="section-top">
            <h2 id="latest-heading">{isEn ? 'Latest writing' : '近作'}</h2>
            <a class="text-link" href={`${prefix}/blog`}>{isEn ? 'View all' : '查看全部'}<Icon name="mdi:arrow-right" /></a>
          </div>
          <ol class="post-list home-posts">
            {posts.slice(0, 4).map(post => <PostRow post={post} isEn={isEn} heading="h3" />)}
          </ol>
          {!posts.length && <p class="empty-state">{isEn ? 'New articles are on the way.' : '文章正在整理中。'}</p>}
        </section>
        <aside class="home-aside">
          <h2>{isEn ? 'Contents by topic' : '分类目录'}</h2>
          <nav class="topic-links" aria-label={isEn ? 'Article categories' : '文章分类'}>
            {categories.map(category => (
              <a href={`${prefix}/blog?category=${encodeURIComponent(category)}`}>
                <span>{category}</span>
                <span class="topic-count">{posts.filter(post => post.data.category === category).length}{isEn ? ' posts' : ' 篇'}</span>
              </a>
            ))}
          </nav>
          <section class="home-about">
            <h2>{isEn ? 'About me' : '关于我'}</h2>
            <p>{isEn ? 'Computer science undergraduate at Peking University.' : '北京大学计算机科学与技术专业本科生。'}</p>
            <a class="text-link" href={`${prefix}/cv`}>{isEn ? 'View my CV' : '查看简历'}<Icon name="mdi:arrow-right" /></a>
          </section>
        </aside>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
