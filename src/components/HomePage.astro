---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import { Icon } from 'astro-icon/components';
import { getBlogPosts, postDate, postSlug } from '../utils/posts';
import '../styles/retreat.css';
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}${isEn ? '/en' : ''}`;
const stateKey = `shane-retreat:${base}`;
const posts = (await getBlogPosts(isEn)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories = [...new Set(posts.map(post => post.data.category).filter((category): category is string => !!category))];
const recentCount = Math.min(8, posts.length);
const touchNames: Record<string, string> = isEn ? { books: 'Books', notebook: 'Recent', workbench: 'Projects', letter: 'About' } : { books: '藏书', notebook: '近作', workbench: '项目', letter: '小笺' };
// Image and links share the complete 1672 × 941 canvas on every screen.
const objects = [
  { id: 'books', x: 25.6, y: 55.2, w: 14.7, h: 16.5, label: isEn ? 'The books' : '架上藏书', detail: isEn ? 'All writing' : '翻阅文章', href: `${prefix}/blog`, view: 'all' },
  { id: 'notebook', x: 48.1, y: 72.1, w: 29.6, h: 16.8, label: isEn ? 'The notebook' : '案头近作', detail: isEn ? 'Recent entries' : '最近写下的', href: `${prefix}/blog`, view: 'recent' },
  { id: 'workbench', x: 83.8, y: 47.2, w: 11.3, h: 11.7, label: isEn ? 'The workbench' : '手边造物', detail: isEn ? 'Projects' : '项目与尝试', href: `${prefix}/projects` },
  { id: 'letter', x: 77.9, y: 77.4, w: 18.3, h: 11.4, label: isEn ? 'A letter' : '主人小笺', detail: isEn ? 'About the author' : '关于我', href: `${prefix}/cv` },
];
---
<Layout title={isEn ? 'Shane Lorien · A mountain study' : 'Shane Lorien · 山中书斋'} section="home" spatial>
  <script is:inline define:vars={{ stateKey }}>
    (() => {
      const root = document.documentElement;
      let remembered = 'mountain';
      try { remembered = sessionStorage.getItem(stateKey) || remembered; } catch {}
      root.dataset.retreatScene = location.hash === '#study' ? 'study' : location.hash === '#mountain' ? 'mountain' : remembered === 'study' ? 'study' : 'mountain';
      root.classList.add('retreat-js');
    })();
  </script>
  <div class="retreat" data-retreat data-state-key={stateKey} data-language={isEn ? 'en' : 'zh'}>
    <header class="retreat-chrome"><Navigation /></header>
    <main id="main-content" class="retreat-main">
      <section class="retreat-scene retreat-mountain" id="mountain" data-scene="mountain" aria-labelledby="mountain-title">
        <div class="retreat-image-frame">
          <div class="retreat-canvas" data-scene-canvas>
            <img class="retreat-painting" src={`${base}/scenes/mountain-gate.webp`} width="1672" height="941" alt={isEn ? 'A winding mountain path leads to a warmly lit study beneath the cliffs.' : '青绿山间，一条石径通向崖下亮着暖灯的书斋。'} fetchpriority="high" decoding="async" />
            <a class="retreat-spot retreat-door" href="#study" data-enter-study style="--spot-x:83.2%;--spot-y:76.8%;--spot-width:7%;--spot-height:14.5%" aria-label={isEn ? 'Enter the mountain study' : '推门，进入书斋'}>
              <span class="retreat-spot-label"><span>{isEn ? 'Enter' : '入室'}</span></span>
            </a>
          </div>
          <div class="retreat-atmosphere" aria-hidden="true"></div>
        </div>
        <header class="retreat-introduction">
          <p class="retreat-eyebrow">{isEn ? 'Notes from a mountain study' : '山中书斋 · 随笔与札记'}</p>
          <h1 id="mountain-title" tabindex="-1">Shane Lorien</h1>
          <blockquote class="retreat-motto">{isEn ? <><span>What power has the light of night?</span><span>It dies. How is it born again?</span></> : <><span>夜光何德？</span><span>死则又育？</span></>}</blockquote>
          <a class="retreat-enter" href="#study" data-enter-study><span>{isEn ? 'Come into the study' : '循灯入室'}</span></a>
          <p class="retreat-invitation">{isEn ? 'A few books, a quiet desk, and things still taking shape.' : '有书可翻，有事可记。且进来坐坐。'}</p>
        </header>
        <div class="retreat-scene-note" aria-hidden="true"><span>{isEn ? 'Beyond the clouds' : '云深处'}</span><span class="retreat-note-line"></span><span>{isEn ? 'A light is on' : '灯尚明'}</span></div>
      </section>
      <section class="retreat-scene retreat-study" id="study" data-scene="study" aria-labelledby="study-title">
        <header class="retreat-study-heading"><p class="retreat-eyebrow">Shane Lorien</p><h2 id="study-title" tabindex="-1">{isEn ? 'The study' : '书斋'}</h2><p>{isEn ? 'Take a book. Stay a while.' : '取一册书，坐一会儿。'}</p></header>
        <div class="retreat-image-frame">
          <div class="retreat-canvas" data-scene-canvas>
            <img class="retreat-painting" src={`${base}/scenes/cave-study.webp`} width="1672" height="941" alt={isEn ? 'Inside the study: stacked books on the left, an open notebook on the desk, a small workbench and a letter on the right, with mountains beyond the window.' : '书斋内景：左侧堆着书，桌上摊着笔记，右侧是工作台与信笺，窗外仍是远山。'} fetchpriority="low" decoding="async" />
            {objects.map(object => (
              <a class:list={['retreat-spot', `retreat-object-${object.id}`]} href={object.href} style={`--spot-x:${object.x}%;--spot-y:${object.y}%;--spot-width:${object.w}%;--spot-height:${object.h}%`} data-catalogue-open={object.view} data-study-destination={object.id} aria-label={`${object.label} · ${object.detail}`}>
                <span class="retreat-spot-label"><span class="retreat-spot-name">{object.label}</span><span class="retreat-spot-touch-name">{touchNames[object.id]}</span><span class="retreat-spot-detail">{object.detail}</span></span>
              </a>
            ))}
          </div>
        </div>
        <nav class="retreat-touch-directory" aria-label={isEn ? 'Around the study' : '书斋中的物件'}>
          {objects.map(object => (
            <a href={object.href} data-catalogue-open={object.view} data-study-destination={object.id}><span><strong>{object.label}</strong><small>{object.detail}</small></span></a>
          ))}
        </nav>
        <div class="retreat-study-bottom"><a class="retreat-outside" href="#mountain" data-leave-study>{isEn ? 'Back to the mountains' : '回到山间'}</a><p class="retreat-desktop-hint">{isEn ? 'The objects on the desk are yours to explore.' : '书与手稿，皆可翻阅。'}</p></div>
      </section>
    </main>
    <footer class="retreat-colophon"><p>{isEn ? 'Mathematics, computer science, and reading.' : '数学、计算机，以及阅读中的思考。'}</p><div><span>© {new Date().getFullYear()} Shane Lorien</span><a href={`${prefix}/blog`}>{isEn ? 'All writing' : '全部文章'}</a></div></footer>
    <dialog id="study-catalogue" class="retreat-catalogue" aria-labelledby="catalogue-title" data-study-catalogue>
      <header class="retreat-catalogue-heading"><div><p class="retreat-eyebrow">{isEn ? 'From the shelves' : '书斋藏书'}</p><h2 id="catalogue-title" tabindex="-1">{isEn ? 'Writing & notes' : '随笔与札记'}</h2></div><form method="dialog"><button class="retreat-close" type="submit" aria-label={isEn ? 'Close and return to the study' : '合上目录，回到书斋'}><Icon name="mdi:close" /></button></form></header>
      <div class="retreat-catalogue-controls"><div class="retreat-catalogue-views" role="group" aria-label={isEn ? 'Choose a collection' : '选择文章范围'}><button type="button" data-catalogue-view="all" aria-pressed="true">{isEn ? 'All writing' : '全部文章'}<span>{posts.length}</span></button><button type="button" data-catalogue-view="recent" aria-pressed="false">{isEn ? 'Recent entries' : '案头近作'}<span>{recentCount}</span></button></div><label class="retreat-category-label" for="study-category"><span>{isEn ? 'Topic' : '分类'}</span><select id="study-category"><option value="">{isEn ? 'All topics' : '所有分类'}</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label></div>
      <p class="retreat-catalogue-status" role="status" data-catalogue-status>{isEn ? `${posts.length} entries` : `共 ${posts.length} 篇`}</p>
      <ol class="retreat-catalogue-list" data-catalogue-list>{posts.map((post, index) => (
        <li data-catalogue-post data-category={post.data.category || ''} data-recent={index < recentCount ? 'true' : 'false'}><a href={`${prefix}/blog/${postSlug(post)}`}><span class="retreat-entry-text"><strong>{post.data.title}</strong><span>{post.data.category}<time datetime={post.data.pubDate.toISOString()}>{postDate(post.data.pubDate, isEn)}</time></span></span></a></li>
      ))}</ol>
      <footer class="retreat-catalogue-footer"><span>{isEn ? 'Open a page; the room will be here when you return.' : '书斋在此，随时回来。'}</span><a href={`${prefix}/blog`}>{isEn ? 'Go to the full archive' : '前往文章目录'}</a></footer>
    </dialog>
    <div class="retreat-transition" aria-hidden="true"></div>
  </div>
  <noscript><style is:inline>.retreat-chrome #search-btn,.retreat-chrome #theme-toggle{display:none}</style><p class="retreat-noscript">{isEn ? 'Follow the links in the study to read the blog, explore projects, or meet the author.' : '点击书斋中的物件，即可阅读文章、查看项目或了解作者。'}</p></noscript>
  <script>import '../scripts/retreat';</script>
</Layout>
