---
import { Icon } from 'astro-icon/components';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
const isEn = path.startsWith('/en');
const localPath = isEn ? path.replace(/^\/en/, '') || '/' : path;
const prefix = `${base}${isEn ? '/en' : ''}`;
const toggleUrl = `${base}${isEn ? '' : '/en'}${localPath === '/' ? '/' : localPath}`;
const section = localPath.split('/')[1] || '';
const navItems = [
  { key: 'cv', label: isEn ? 'CV' : '简历' },
  { key: 'blog', label: isEn ? 'Blog' : '博客' },
  { key: 'projects', label: isEn ? 'Projects' : '项目' },
];
---
<nav class="site-nav" aria-label={isEn ? 'Main navigation' : '主导航'}>
  <a href={`${prefix}/`} class="brand">Shane Lorien</a>
  <div class="nav-links">
    {navItems.map(item => (
      <a href={`${prefix}/${item.key}`} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
    ))}
  </div>
  <div class="nav-tools">
    <button id="search-btn" class="icon-button" aria-label={isEn ? 'Search articles' : '搜索文章'} title={isEn ? 'Search (Ctrl / ⌘ K)' : '搜索（Ctrl / ⌘ K）'}>
      <Icon name="mdi:magnify" />
    </button>
    <button id="theme-toggle" class="icon-button" aria-label={isEn ? 'Toggle dark mode' : '切换深色模式'} aria-pressed="false">
      <Icon name="mdi:weather-sunny" class="theme-sun" />
      <Icon name="mdi:weather-night" class="theme-moon" />
    </button>
    <a href={toggleUrl} class="icon-button" aria-label={isEn ? '切换为中文' : 'Switch to English'}>{isEn ? '中' : 'EN'}</a>
    <a href="https://github.com/logic61" class="icon-button nav-secondary" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="mdi:github" /></a>
    <a href="mailto:logic.dreemurr@gmail.com" class="icon-button nav-secondary" aria-label={isEn ? 'Email' : '邮箱'}><Icon name="mdi:email-outline" /></a>
  </div>
</nav>

<dialog id="search-modal" class="search-dialog" aria-label={isEn ? 'Search articles' : '搜索文章'} data-base={base} data-language={isEn ? 'en' : 'zh'}>
  <div class="search-header">
    <Icon name="mdi:magnify" />
    <input id="search-input" type="search" aria-label={isEn ? 'Search by title, category or description' : '搜索标题、分类或摘要'} placeholder={isEn ? 'Search articles…' : '搜索文章、分类…'} autocomplete="off" />
    <button id="search-close" class="icon-button" aria-label={isEn ? 'Close search' : '关闭搜索'}><Icon name="mdi:close" /></button>
  </div>
  <div class="search-body">
    <p id="search-status" class="search-status" role="status">{isEn ? 'Search by title, category or description.' : '输入关键词，搜索标题、分类或摘要。'}</p>
    <ul id="search-results" class="search-results" hidden></ul>
  </div>
  <div class="search-footer">{isEn ? 'Esc to close · Tab to select a result' : 'Esc 关闭 · Tab 选择搜索结果'}</div>
</dialog>

<script>
  interface SearchItem { title: string; description: string; category: string; slug: string; }
  const themeButton = document.getElementById('theme-toggle');
  const updateThemeButton = () => themeButton?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
  updateThemeButton();
  themeButton?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
    updateThemeButton();
  });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', event => {
    let saved;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (saved !== 'dark' && saved !== 'light') {
      document.documentElement.classList.toggle('dark', event.matches);
      updateThemeButton();
    }
  });

  const dialog = document.getElementById('search-modal') as HTMLDialogElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;
  const status = document.getElementById('search-status')!;
  const isEn = dialog.dataset.language === 'en';
  const base = dialog.dataset.base || '';
  let data: SearchItem[] | null = null;
  let loading: Promise<void> | null = null;
  const initialText = isEn ? 'Search by title, category or description.' : '输入关键词，搜索标题、分类或摘要。';
  const setStatus = (text: string) => { status.textContent = text; status.hidden = false; results.hidden = true; };
  const appendHighlighted = (element: HTMLElement, text: string, query: string) => {
    const position = text.toLowerCase().indexOf(query);
    if (position < 0) { element.textContent = text; return; }
    element.append(document.createTextNode(text.slice(0, position)));
    const mark = document.createElement('mark');
    mark.textContent = text.slice(position, position + query.length);
    element.append(mark, document.createTextNode(text.slice(position + query.length)));
  };
  const renderResults = () => {
    const query = input.value.trim().toLowerCase();
    results.replaceChildren();
    if (!query) { setStatus(initialText); return; }
    if (!data) return;
    const matches = data.map(item => ({
      item, score: (item.title.toLowerCase().includes(query) ? 3 : 0)
        + (item.category.toLowerCase().includes(query) ? 2 : 0)
        + (item.description.toLowerCase().includes(query) ? 1 : 0),
    })).filter(match => match.score > 0).sort((a, b) => b.score - a.score);
    if (!matches.length) { setStatus(isEn ? 'No matching articles.' : '没有找到相关文章。'); return; }
    status.hidden = true;
    results.hidden = false;
    for (const { item } of matches) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = `${base}${isEn ? '/en' : ''}/blog/${item.slug}`;
      const title = document.createElement('h3');
      appendHighlighted(title, item.title, query);
      link.append(title);
      if (item.description) {
        const description = document.createElement('p');
        appendHighlighted(description, item.description.slice(0, 120), query);
        link.append(description);
      }
      li.append(link);
      results.append(li);
    }
  };
  const openSearch = async () => {
    if (dialog.open) return;
    dialog.showModal();
    input.focus();
    if (data) { renderResults(); return; }
    setStatus(isEn ? 'Loading articles…' : '正在加载文章…');
    if (!loading) {
      loading = (async () => {
        try {
          const response = await fetch(`${base}/api/search.json`);
          if (!response.ok) throw new Error('Search index unavailable');
          data = await response.json();
          renderResults();
        } catch {
          setStatus(isEn ? 'Could not load articles. Close and reopen to retry.' : '文章加载失败，请关闭后重新打开以重试。');
        } finally { loading = null; }
      })();
    }
    await loading;
  };
  document.getElementById('search-btn')?.addEventListener('click', openSearch);
  document.getElementById('search-close')?.addEventListener('click', () => dialog.close());
  input.addEventListener('input', renderResults);
  dialog.addEventListener('click', event => {
    const rect = dialog.getBoundingClientRect();
    if (event.target === dialog && (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom)) dialog.close();
  });
  dialog.addEventListener('close', () => { input.value = ''; results.replaceChildren(); setStatus(initialText); });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && dialog.open) {
      event.preventDefault();
      dialog.close();
      return;
    }
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });
</script>
