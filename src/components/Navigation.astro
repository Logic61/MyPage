---
import { Icon } from 'astro-icon/components';

const pathname = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const cleanPath = pathname.startsWith(basePath) ? pathname.slice(basePath.length) || '/' : pathname;
const isEn = cleanPath.startsWith('/en');

// Calculate toggle URL
const pathWithoutEn = isEn ? cleanPath.replace(/^\/en/, '') || '/' : cleanPath;
const targetCleanPath = isEn ? pathWithoutEn : `/en${pathWithoutEn === '/' ? '' : pathWithoutEn}`;
const toggleUrl = `${basePath}${targetCleanPath}`.replace(/\/+$/, '') || '/MyPage';

const section = pathWithoutEn.split('/')[1] || '';
const navItems = [
  { key: 'cv', href: isEn ? "/MyPage/en/cv" : "/MyPage/cv", label: isEn ? "CV" : "简历" },
  { key: 'blog', href: isEn ? "/MyPage/en/blog" : "/MyPage/blog", label: isEn ? "Blog" : "博客" },
  { key: 'projects', href: isEn ? "/MyPage/en/projects" : "/MyPage/projects", label: isEn ? "Projects" : "项目" },
];

const ghostBtn = "w-8 h-8 inline-flex items-center justify-center rounded-sm text-stone-500 hover:text-stone-900 hover:bg-stone-100 active:scale-95 transition-all dark:text-stone-400 dark:hover:text-stone-100 dark:hover:bg-stone-800/70 cursor-pointer";
---

<nav class="flex items-center justify-between gap-6 mb-16">
  <a href={isEn ? "/MyPage/en" : "/MyPage/"} class="font-serif font-semibold text-xl tracking-tight whitespace-nowrap text-stone-900 hover:text-accent dark:text-stone-100 dark:hover:text-accent-dark transition-colors">
    Shane Lorien
  </a>
  <div class="flex items-center gap-5 sm:gap-6 font-serif text-[15px]">
    {navItems.map(item => (
      <a
        href={item.href}
        aria-current={section === item.key ? 'page' : undefined}
        class={section === item.key
          ? "font-semibold text-accent dark:text-accent-dark transition-colors"
          : "text-stone-500 hover:text-stone-900 dark:text-stone-400 dark:hover:text-stone-100 transition-colors"}
      >{item.label}</a>
    ))}
    <div class="w-px h-4 bg-stone-200 dark:bg-stone-800"></div>
    <div class="flex items-center gap-1">
      <button id="search-btn" class={ghostBtn} aria-label="Search">
        <Icon name="mdi:magnify" class="w-[18px] h-[18px]" />
      </button>
      <button id="theme-toggle" class={ghostBtn} aria-label="Toggle Theme">
        <Icon name="mdi:theme-light-dark" class="w-[18px] h-[18px]" />
      </button>
      <a href={toggleUrl} title="Toggle Language" class={`${ghostBtn} font-serif text-sm font-semibold`} aria-label="Toggle Language">
        {isEn ? "中" : "EN"}
      </a>
      <a href="https://github.com/logic61" class={ghostBtn} target="_blank" aria-label="GitHub">
        <Icon name="mdi:github" class="w-[18px] h-[18px]" />
      </a>
      <a href="mailto:logic.dreemurr@gmail.com" class={ghostBtn} aria-label="Email">
        <Icon name="mdi:email-outline" class="w-[18px] h-[18px]" />
      </a>
    </div>
  </div>
</nav>

<!-- 搜索弹窗 -->
<div id="search-modal" class="fixed inset-0 z-50 hidden items-start justify-center pt-[15vh] px-4" aria-modal="true" role="dialog">
  <div id="search-backdrop" class="fixed inset-0 bg-stone-900/50 backdrop-blur-sm transition-opacity opacity-0 cursor-pointer"></div>

  <div id="search-container" class="relative w-full max-w-2xl bg-paper dark:bg-nightsoft rounded-sm shadow-2xl overflow-hidden transform transition-all scale-95 opacity-0 flex flex-col border border-stone-200 dark:border-stone-800 pointer-events-auto">
    <div class="flex items-center px-4 py-4 border-b border-stone-100 dark:border-stone-800">
      <Icon name="mdi:magnify" class="w-5 h-5 text-stone-400 shrink-0" />
      <input
        id="search-input"
        type="text"
        placeholder={isEn ? "Search posts..." : "搜索文章..."}
        class="w-full bg-transparent border-none focus:ring-0 font-serif text-stone-800 dark:text-stone-100 placeholder-stone-400 text-lg px-4 outline-none"
        autocomplete="off"
      />
      <button id="search-close" class="p-1 rounded-sm text-stone-400 hover:bg-stone-100 hover:text-stone-600 dark:hover:bg-stone-800 dark:hover:text-stone-300 transition-colors">
        <Icon name="mdi:close" class="w-5 h-5" />
      </button>
    </div>

    <div class="max-h-[60vh] overflow-y-auto">
      <ul id="search-results" class="py-2 px-2 hidden"></ul>
      <div id="search-empty" class="py-12 text-center font-serif text-stone-500 dark:text-stone-400 hidden">
        {isEn ? "No results found." : "没有找到相关文章。"}
      </div>
    </div>

    <div class="px-4 py-3 bg-stone-50 dark:bg-stone-800/50 border-t border-stone-100 dark:border-stone-800 text-xs text-stone-500 dark:text-stone-400 flex items-center justify-between font-serif">
      <span>{isEn ? "Type to search by title, description or category" : "输入以搜索标题、描述或分类"}</span>
      <span class="flex items-center gap-1"><kbd class="px-1.5 py-0.5 rounded-sm bg-paper dark:bg-nightsoft border border-stone-200 dark:border-stone-700 font-serif text-[10px]">ESC</kbd> {isEn ? "to close" : "关闭"}</span>
    </div>
  </div>
</div>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  }

  document.getElementById("theme-toggle")?.addEventListener("click", handleToggleClick);

  // --- 搜索功能逻辑 ---
  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchContainer = document.getElementById('search-container');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClose = document.getElementById('search-close');
  const searchResults = document.getElementById('search-results');
  const searchEmpty = document.getElementById('search-empty');

  let searchData: any[] | null = null;
  const isEnPath = window.location.pathname.replace('/MyPage', '').startsWith('/en');

  const openSearch = async () => {
    if (!searchModal || !searchBackdrop || !searchContainer || !searchInput) return;

    searchModal.classList.remove('hidden');
    searchModal.classList.add('flex');

    requestAnimationFrame(() => {
      searchBackdrop.classList.remove('opacity-0');
      searchBackdrop.classList.add('opacity-100');
      searchContainer.classList.remove('scale-95', 'opacity-0');
      searchContainer.classList.add('scale-100', 'opacity-100');
    });

    searchInput.focus();

    if (!searchData) {
      try {
        const res = await fetch('/MyPage/api/search.json');
        searchData = await res.json();
      } catch (err) {
        console.error("Failed to load search index:", err);
      }
    }
  };

  const closeSearch = () => {
    if (!searchModal || !searchBackdrop || !searchContainer || !searchInput || !searchResults || !searchEmpty) return;

    searchBackdrop.classList.remove('opacity-100');
    searchBackdrop.classList.add('opacity-0');
    searchContainer.classList.remove('scale-100', 'opacity-100');
    searchContainer.classList.add('scale-95', 'opacity-0');

    setTimeout(() => {
      searchModal.classList.remove('flex');
      searchModal.classList.add('hidden');
      searchInput.value = '';
      searchResults.innerHTML = '';
      searchResults.classList.add('hidden');
      searchEmpty.classList.add('hidden');
    }, 200);
  };

  searchBtn?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchBackdrop?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchModal && !searchModal.classList.contains('hidden')) {
      closeSearch();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  const highlight = (text: string, query: string) => {
    const safe = escapeHtml(text);
    const idx = safe.toLowerCase().indexOf(query);
    if (idx < 0) return safe;
    return safe.slice(0, idx)
      + '<mark class="bg-accent/20 dark:bg-accent-dark/20 text-stone-900 dark:text-stone-100 rounded-sm px-0.5">'
      + safe.slice(idx, idx + query.length)
      + '</mark>'
      + safe.slice(idx + query.length);
  };

  searchInput?.addEventListener('input', () => {
    if (!searchResults || !searchEmpty || !searchInput) return;

    const query = searchInput.value.trim().toLowerCase();
    if (!query) {
      searchResults.classList.add('hidden');
      searchEmpty.classList.add('hidden');
      return;
    }

    if (!searchData) return;

    // 加权: 标题命中 ×3, 分类 ×2, 描述 ×1
    const scored = searchData
      .map(item => {
        const t = (item.title || '').toLowerCase();
        const c = (item.category || '').toLowerCase();
        const d = (item.description || '').toLowerCase();
        let score = 0;
        if (t.includes(query)) score += 3;
        if (c.includes(query)) score += 2;
        if (d.includes(query)) score += 1;
        return { item, score };
      })
      .filter(x => x.score > 0)
      .sort((a, b) => b.score - a.score);

    if (scored.length > 0) {
      searchEmpty.classList.add('hidden');
      searchResults.classList.remove('hidden');

      searchResults.innerHTML = scored.map(({ item }) => {
        const slug = item.slug.startsWith('en/') ? item.slug.replace('en/', '') : item.slug;
        const finalUrl = isEnPath ? `/en/blog/${slug}` : `/blog/${slug}`;
        const titleHtml = highlight(item.title || '', query);
        const descHtml = item.description ? highlight(item.description, query) : '';

        return `
          <li>
            <a href="${finalUrl}" class="group flex flex-col gap-0.5 p-3 rounded-sm hover:bg-stone-50 dark:hover:bg-stone-800 transition-colors">
              <h4 class="text-base font-medium font-serif text-stone-800 dark:text-stone-200 group-hover:text-accent dark:group-hover:text-accent-dark truncate transition-colors">${titleHtml}</h4>
              ${descHtml ? `<p class="text-xs text-stone-500 dark:text-stone-400 line-clamp-1">${descHtml}</p>` : ''}
            </a>
          </li>
        `;
      }).join('');
    } else {
      searchResults.classList.add('hidden');
      searchEmpty.classList.remove('hidden');
    }
  });
</script>
