---
/**
 * 山影：页面背景的生成水墨。
 *
 * 默认底图为生成水墨，首页通过插槽提供青绿山水。
 * 两种底图共用一层活动的雾与飞鸟。
 */
interface Props { mistSrc?: string; }
const { mistSrc } = Astro.props;
---
<div class="page-landscape page-ink" aria-hidden="true">
  <slot><canvas class="ink-base" data-ink-base></canvas></slot>
  <canvas class="ink-live" data-ink-live data-mist-src={mistSrc}></canvas>
</div>

<script>
  import { mountInkLandscape } from '../scripts/ink-landscape.js';
  mountInkLandscape();
</script>
