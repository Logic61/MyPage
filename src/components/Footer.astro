---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname;
const cleanPath = pathname.startsWith(basePath) ? pathname.slice(basePath.length) || '/' : pathname;
const isEn = cleanPath.startsWith('/en');
---

<footer class="mt-24 pt-6 pb-2 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between flex-wrap gap-2 font-serif text-sm text-stone-400 dark:text-stone-600">
  <span>© 2026 Shane Lorien</span>
  <div class="flex items-center gap-4">
    <a href="https://github.com/logic61" target="_blank" rel="noopener noreferrer" class="hover:text-accent dark:hover:text-accent-dark transition-colors">GitHub</a>
    <a href="mailto:logic.dreemurr@gmail.com" class="hover:text-accent dark:hover:text-accent-dark transition-colors">{isEn ? "Email" : "邮箱"}</a>
  </div>
</footer>
