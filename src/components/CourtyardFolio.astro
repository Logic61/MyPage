---
import FolioGlyph from './FolioGlyph.astro';
import { CHESS_PAVILION, COURT_OUTLINE, EAST_BRIDGE, GALLERY, HALL_STEPS, LIBRARY_ENTRY, NORTH_HALL_SETBACK, TEA_PAVILION, WING } from '../scripts/mountain-world/hall-terrace';
import { COURTYARD_POOL, FORECOURT_PLANTER } from '../scripts/mountain-world/water-court';
import { getBlogPosts, postDate, postDescription, postSlug } from '../utils/posts';

interface Props { isEn: boolean; }
const { isEn } = Astro.props;
const t = (zh: string, en: string) => isEn ? en : zh;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = base + (isEn ? '/en' : '');
const wingCentre = (WING.inner+WING.outer)/2;
const chessFootprint = Array.from({length:6}, (_,i) => {
  const {x,z,eaves,orientation} = CHESS_PAVILION, angle = orientation+i*Math.PI/3;
  return `${x+eaves*Math.cos(angle)},${z-eaves*Math.sin(angle)}`;
}).join(' ');
const posts = (await getBlogPosts(isEn)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryOf = (post: typeof posts[number]) => post.data.category || t('手记', 'Notes');
const categories = [...new Set(posts.map(categoryOf))];
const tabs = [
  { id: 'blog', label: t('博客', 'Blog') }, { id: 'projects', label: t('项目', 'Projects') },
  { id: 'cv', label: t('简历', 'CV') },
] as const;
const places = [
  { id: 'books', section: 'blog', glyph: 'blog', name: t('藏书架', 'Bookshelf'), place: t('西翼 · 博客', 'West wing · Writing') },
  { id: 'projects', section: 'projects', glyph: 'projects', name: t('项目', 'Projects'), place: t('东翼 · 工作案', 'East wing · Workbench') },
  { id: 'about', section: 'cv', glyph: 'cv', name: t('简历', 'CV'), place: t('北厅东壁 · 挂轴', 'North hall · Hanging scroll') },
  { id: 'bench', section: null, glyph: 'map', name: t('临崖小坐', 'Cliffside bench'), place: t('东桥南侧 · 临云茶榭', 'Tea pavilion south of the east bridge') },
  { id: 'sunwheel', section: null, glyph: 'map', name: t('日轮台', 'Sunwheel Terrace'), place: t('东云栈 · 临崖', 'Across the eastern skywalk') },
] as const;
---
<dialog id="folio" aria-labelledby="folio-title" data-world-reader data-tab="blog" style={`--vellum:url("${base}/world/folio-paper.webp")`}>
  <div class="parchment">
    <div class="scroll-rod upper" aria-hidden="true"></div>
    <div class="parchment-leaf">
      <header class="folio-bar">
        <nav aria-label={t('卷宗', 'Folio sections')}>
          {tabs.map(tab => <a href={`${prefix}/${tab.id}/`} data-section-link={tab.id}><FolioGlyph name={tab.id}/><span>{tab.label}</span></a>)}
          <button type="button" data-section-link="map"><FolioGlyph name="map"/><span>{t('地图', 'Map')}</span></button>
        </nav>
        <button type="button" id="close" data-world-action="close" aria-label={t('收卷，回到书斋', 'Roll up and return')}><span>{t('收卷','Close')}</span><i aria-hidden="true">×</i></button>
      </header>
      <h2 id="folio-title" class="mw-sr-only">{t('云庭书卷', 'Cloud Court folio')}</h2>
      <div class="manuscript" data-catalogue="closed">
        <aside class="folio-catalogue" data-reader-directory aria-label={t('藏书目录', 'Writing index')}>
          <div class="catalogue-top"><h3 data-catalogue-title>{t('藏书目录', 'Contents')}</h3><button type="button" id="hide-contents">{t('回到正文', 'Return to text')}</button></div>
          <div class="catalogue-tools">
            <input id="find-writing" data-world-search type="search" autocomplete="off" placeholder={t('查找篇名', 'Find a title')} aria-label={t('查找篇名', 'Find a title')}/>
            <select id="category" data-world-category aria-label={t('文章分类', 'Filter by subject')}><option value="">{t('全部分类', 'All subjects')}</option>{categories.map(c => <option value={c}>{c}</option>)}</select>
          </div>
          <div class="catalogue-list">
            {posts.map(post => <div data-world-post><a href={`${prefix}/blog/${postSlug(post)}/`} data-world-article data-manuscript={`${base}/manuscripts/${isEn ? 'en' : 'zh'}/${postSlug(post)}/index.html`} data-slug={postSlug(post)}
              data-alias={isEn ? `${prefix}/blog/${post.id}/` : undefined} data-category={categoryOf(post)} data-description={postDescription(post)}
              data-date={postDate(post.data.pubDate, isEn)} data-author={post.data.author}><span>{post.data.title}</span></a></div>)}
            <p data-world-empty hidden>{t('没有找到匹配的文章。', 'No matching titles.')}</p>
          </div>
          <span class="mw-sr-only" data-world-count aria-live="polite">{t(`共 ${posts.length} 篇`, `${posts.length} ${posts.length === 1 ? 'page' : 'pages'}`)}</span>
        </aside>
        <div class="folio-text-side">
          <button type="button" id="show-contents" aria-expanded="false">{t('选篇 · 藏书目录', 'Choose a text')}</button>
          <div id="folio-reading" data-reader-scroll tabindex="0" role="region" aria-label={t('卷轴正文', 'Manuscript text')}>
            <div id="folio-document">
              <header class="document-title"><p id="rubric"></p><h2 id="reading-title" data-reader-title></h2><p id="byline"></p></header>
              <div id="folio-body" class="scroll-prose" data-reader-article></div>
              <p data-reader-status role="status" hidden></p>
              <nav id="reading-neighbours" aria-label={t('相邻文章', 'Adjacent articles')} hidden><button type="button" id="newer"></button><button type="button" id="older"></button></nav>
              <a class="folio-original" data-reader-original href={`${prefix}/blog/`} target="_blank" rel="noopener noreferrer">{t('打开原页 ↗', 'Open original ↗')}</a>
            </div>
            <section id="folio-map" hidden>
              <header class="document-title"><h2>{t('云庭平面图','Plan of the courtyard')}</h2></header>
              <div class="map-layout">
                <svg class="floorplan" viewBox="-19 -19 56 62" aria-label={t('北为书斋，南为候云台，东为日轮台。金色标记为当前位置。','The study is north, Cloudwatch Landing south and Sunwheel Terrace east. Gold marks your position.')}>
                  <defs><pattern id="hatch" width=".8" height=".8" patternUnits="userSpaceOnUse"><path d="m0 .8.8-.8" stroke="currentColor" stroke-width=".12" opacity=".35"/></pattern></defs>
                  <g fill="none" stroke="currentColor" stroke-width=".2" stroke-linejoin="round">
                    <polygon points={COURT_OUTLINE.map(p=>p.join(',')).join(' ')} fill="#c6bfa32b"/>
                    <g stroke-width=".09">
                      <title>{t('北厅月台及中央石阶','North hall porch and central flight of steps')}</title>
                      <rect x={-HALL_STEPS.halfWidth} y={HALL_STEPS.rear} width={2*HALL_STEPS.halfWidth} height={HALL_STEPS.front-HALL_STEPS.rear}/>
                      {Array.from({length:HALL_STEPS.count-1},(_,i)=>(i+1)*HALL_STEPS.tread).map(run=><>
                        <path d={`M${-HALL_STEPS.stairHalf} ${HALL_STEPS.front}v${run}h${2*HALL_STEPS.stairHalf}v${-run}`}/>
                        {[-1,1].map(side=><path d={`M${side*HALL_STEPS.halfWidth} ${HALL_STEPS.rear}h${side*run}V${HALL_STEPS.front}h${-side*run}`}/>)}
                      </>)}
                    </g>
                    <rect x={-6.1} y={-10 - NORTH_HALL_SETBACK} width="12.2" height="4.2" fill="url(#hatch)"/>
                    {[-1,1].map(side => <g transform={`scale(${side},1)`}>
                      <rect x={WING.inner} y={WING.north} width={WING.outer-WING.inner} height={WING.south-WING.north} fill="url(#hatch)" stroke="none"/>
                      <path d={`M${WING.outer} ${GALLERY.door.from}V${WING.north}H${WING.inner} M${WING.outer} ${GALLERY.door.to}V${WING.south}` +
                        (side<0 ? `H${-LIBRARY_ENTRY.jamb}V${LIBRARY_ENTRY.returnEnd}` : `H${WING.inner}`)}><title>{side<0 ? t('西书阁面池廊口与侧门','Library porch on the pond walk and side door') : t('东翼侧门通往长廊','Side door from the workroom to the gallery')}</title></path>
                      <path d={`M${GALLERY.wall} ${GALLERY.north}H${GALLERY.outerFloor}V${GALLERY.south}H${GALLERY.wall}`} stroke-width=".12"/>
                      {GALLERY.bents.map(z => <circle cx={GALLERY.outerPost} cy={z} r=".15" fill="currentColor" stroke="none"/>)}
                    </g>)}
                    <path d="M-6.1 11.17v1.89h3.9m4.4 0h3.9v-1.89 M-1.65 15.75V31.9m3.3-16.15V31.9"/>
                    {[-1,1].map(side => <line x1={EAST_BRIDGE.landing} x2={EAST_BRIDGE.end}
                      y1={EAST_BRIDGE.z + side*(EAST_BRIDGE.width/2-.11)} y2={EAST_BRIDGE.z + side*(EAST_BRIDGE.width/2-.11)}/>)}
                    {[FORECOURT_PLANTER.x0,-FORECOURT_PLANTER.x1].map(x => <rect x={x} y={FORECOURT_PLANTER.z0}
                      width={FORECOURT_PLANTER.x1-FORECOURT_PLANTER.x0} height={FORECOURT_PLANTER.z1-FORECOURT_PLANTER.z0} fill="#87907966">
                      <title>{t('迎宾台松池','Pine bed on the entrance terrace')}</title>
                    </rect>)}
                    <path d="M-2.99 12.01h5.98v2.42h-5.98z M-2.99 12.01l1.07 1.21-1.07 1.21m1.07-1.21h3.84l1.07-1.21m-1.07 1.21 1.07 1.21" fill="url(#hatch)"/>
                    <rect x={COURTYARD_POOL.x0} y={COURTYARD_POOL.z0} width={COURTYARD_POOL.x1-COURTYARD_POOL.x0} height={COURTYARD_POOL.z1-COURTYARD_POOL.z0} fill="#8fa99c9c"><title>{t('天光水庭 · 方荷池','Water court · Lotus pond')}</title></rect>
                    <g><title>{t('松下棋亭','Pine chess pavilion')}</title><polygon points={chessFootprint}/>
                      <rect x={CHESS_PAVILION.boardX-.705} y={CHESS_PAVILION.boardZ-.64} width="1.41" height="1.28" fill="url(#hatch)" stroke-width=".12"/></g>
                    <a href="#bench" data-world-destination="bench" aria-label={t('指路至临云茶榭','Guide me to the tea pavilion')}>
                      <title>{t('临云茶榭 · 观山坐榻','Cloudview tea pavilion and bench')}</title>
                      <rect x={TEA_PAVILION.x-TEA_PAVILION.eaveHalfX} y={TEA_PAVILION.z-TEA_PAVILION.eaveHalfZ}
                        width={2*TEA_PAVILION.eaveHalfX} height={2*TEA_PAVILION.eaveHalfZ}/>
                      <rect x="-1.205" y="-.30" width="2.41" height=".60" fill="currentColor" stroke="none"
                        transform={`translate(${TEA_PAVILION.benchX} ${TEA_PAVILION.benchZ}) rotate(${-TEA_PAVILION.benchYaw*180/Math.PI})`}/>
                    </a>
                    <circle cx="0" cy="34" r="4.2" fill="url(#hatch)"/>
                    <a href="#sunwheel" data-world-destination="sunwheel" aria-label={t('指路至日轮台','Guide me to Sunwheel Terrace')}>
                      <circle cx="26" cy="5" r="4.3" fill="url(#hatch)"/><circle cx="26" cy="5" r="2.55"/>
                    </a>
                  </g>
                  <g class="map-labels" style="font-size: 1.85px"><text x="0" y="-15.5">N</text><text x={-wingCentre} y="-3.5">{t('藏书','Library')}</text><text x={wingCentre} y="-3.5">{t('工作案','Workbench')}</text><text x="26" y="12">{t('日轮台','Sunwheel Terrace')}</text><text x="0" y="41.1">{t('候云台','Cloudwatch Landing')}</text></g>
                  <g id="map-player" transform="translate(0 34) scale(.17)"><circle r="3.5"/><path d="M0-10l-3.2 5.8h6.4z"/></g>
                </svg>
                <div class="map-directory">{places.map(p => <div>
                  {p.section ? <a href={`${prefix}/${p.section}/`} data-section-link={p.section}><FolioGlyph name={p.glyph}/><span><strong>{p.name}</strong><small>{p.place}</small></span></a>
                    : <span class="map-bench"><FolioGlyph name={p.glyph}/><span><strong>{p.name}</strong><small>{p.place}</small></span></span>}
                  <button type="button" data-world-destination={p.id} aria-label={t('指路至','Guide me to ') + p.name}>{t('指路','Guide me')}</button>
                </div>)}</div>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
    <div class="scroll-rod lower" aria-hidden="true"></div>
  </div>
</dialog>
