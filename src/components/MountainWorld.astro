---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { tracks } from '../scripts/mountain-world/music';
import CourtyardFolio from './CourtyardFolio.astro';
import '../styles/mountain-world.css';
import '../styles/mountain-folio.css';

interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = `${base}${isEn ? '/en' : ''}`;
const config = JSON.stringify({ isEn, prefix, base }).replace(/</g, '\\u003c');
const languageHref = `${base}${isEn ? '' : '/en'}/`;
const marks = [
  {id:'books', icon:'book-open-page-variant-outline', label:isEn ? 'Writing' : '博客', primary:true},
  {id:'about', icon:'script-text-outline', label:isEn ? 'CV' : '简历', primary:true},
  {id:'projects', icon:'compass-rose', label:isEn ? 'Projects' : '项目', primary:true},
  {id:'lantern', icon:'lamp-outline', label:isEn ? 'Lantern' : '点灯'},
  {id:'bench', icon:'pine-tree', label:isEn ? 'Sit here' : '观山'},
];
---

<Layout title={isEn ? 'Cloud Court Study · Shane Lorien' : '云庭书斋 · Shane Lorien'} section="home" spatial>
  <div class="mountain-world" data-mountain-world data-state="poster" data-language={isEn ? 'en' : 'zh'}>
    <main inert id="main-content" class="mw-stage" tabindex="-1" aria-label={isEn ? 'Explore the cloud courtyard' : '探索云庭书斋'}>
      <canvas id="mountain-canvas" tabindex="0" aria-label={isEn ? 'First-person cloud courtyard. WASD to walk. Hold Shift to run. When the mouse is locked, aim with the centre dot and press E or click. After unlocking, click the scene to lock the mouse again. Escape to pause. Touch: left thumbstick to walk, drag on the right to look.' : '第一人称云庭书斋。WASD 行走，按住 Shift 奔跑。鼠标锁定时用中心准心瞄准，按 E 或左键交互；脱锁后点击画面即可重新锁定。Esc 暂停。触屏使用左侧摇杆行走、右侧拖动环顾。'}></canvas>
      <div class="mw-vignette" aria-hidden="true"></div>
    </main>

    <div class="mw-arrival" data-world-arrival>
      <img class="mw-cover" src={`${base}/world/courtyard-entrance.webp`} width="1560" height="960" fetchpriority="high" alt="" />
      <h1 class="mw-cover-title" lang="en">Shane Lorien's Page</h1>
      <div class="mw-cover-actions">
        <button type="button" class="mw-enter-button" data-world-load>{isEn ? 'Enter the courtyard' : '走进云庭'}</button>
        <a class="mw-read-button" href={`${prefix}/static/`}>{isEn ? 'Static site' : '静态页面'}</a>
      </div>
    </div>
    <header class="mw-header">
      <a class="mw-brand" href={`${prefix}/`} aria-label={isEn ? 'Cloud Court Study · home' : '云庭书斋 · 首页'}>
        <span class="mw-seal" aria-hidden="true">山<br />居</span>
        <span class="mw-brand-type"><strong>{isEn ? 'Cloud Court Study' : '云庭书斋'}</strong><span>SHANE LORIEN</span></span>
      </a>
      <nav class="mw-tools" aria-label={isEn ? 'Study controls' : '书斋操作'}>
        <button type="button" class="mw-lock-button" data-world-lock aria-label={isEn ? 'Lock the mouse and aim with the centre dot' : '锁定鼠标，使用中心准心环顾与交互'}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="5" /><path d="M12 2v4m0 12v4M2 12h4m12 0h4" /></svg><span>{isEn ? 'Lock mouse' : '锁定鼠标'}</span></button>
        <a href={`${prefix}/blog`} class="mw-directory-button" data-world-action="directory"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5h14M5 12h14M5 19h14" /></svg><span>{isEn ? 'Directory' : '目录'}</span></a>
        <button type="button" class="mw-tool-button" data-world-action="sound" aria-pressed="false" disabled>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4V5Z" /><path class="mw-sound-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /><path class="mw-sound-cross" d="m16 9 5 6m0-6-5 6" /></svg>
          <span class="mw-sr-only" data-sound-label>{isEn ? 'Background music' : '背景音乐'}</span>
        </button>
        <button type="button" data-world-settings-open aria-haspopup="dialog"><Icon name="mdi:cog-outline" /><span>{isEn ? 'Settings' : '设置'}</span></button>
        <button type="button" class="mw-tool-button" data-world-action="reset" aria-label={isEn ? 'Return to Cloudwatch Landing' : '回到候云台'} disabled><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 8M4 4v6h6" /></svg></button>
        <button type="button" class="mw-tool-button" data-world-pause aria-label={isEn ? 'Pause exploring' : '暂停探索'} hidden><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg></button>
        <a class="mw-language" href={languageHref} lang={isEn ? 'zh-CN' : 'en'} aria-label={isEn ? '中文版本' : 'English version'}>{isEn ? '中' : 'EN'}</a>
      </nav>
    </header>

    <div class="mw-loading" data-world-loading role="status">
      <span class="mw-loading-orbit" aria-hidden="true"></span>
      <p>{isEn ? 'A courtyard above the clouds' : '云庭有光'}</p>
      <span>{isEn ? 'Preparing the courtyard, pages, and mountain views…' : '正在铺开庭院、纸页与山色…'}</span>
    </div>

    <section class="mw-entry" data-world-entry aria-labelledby="mw-entry-title" hidden>
      <div class="mw-entry-card">
        <h1 id="mw-entry-title" data-world-entry-title>{isEn ? 'Stay a little longer.' : '稍作停留。'}</h1>
        <p class="mw-entry-copy" data-world-entry-copy>{isEn ? 'The study is waiting, just where you left it.' : '书斋仍在，回到刚才驻足的地方。'}</p>
        <div class="mw-entry-actions"><button type="button" class="mw-enter-button" data-world-enter><span class="mw-gate-glyph" aria-hidden="true">⟶</span><span data-world-enter-label>{isEn ? 'Continue exploring' : '继续探索'}</span></button><a class="mw-read-button" href={`${prefix}/static/`}>{isEn ? 'Static site' : '静态页面'}</a></div>

      </div>
    </section>
    <dialog class="mw-settings" data-world-settings aria-labelledby="mw-settings-title">
      <div class="mw-settings-head"><h2 id="mw-settings-title">{isEn ? 'Settings' : '设置'}</h2>
        <button type="button" data-world-settings-close aria-label={isEn ? 'Close settings' : '关闭设置'}>×</button></div>
      <div class="mw-settings-fields">
          <label><span>{isEn ? 'Picture' : '画面'}</span><select data-world-quality><option value="detail">{isEn ? 'Detailed' : '细致'}</option><option value="smooth">{isEn ? 'Smooth' : '流畅'}</option></select></label>
          <label><span>{isEn ? 'Look sensitivity' : '视角灵敏度'}</span><input type="range" min="0.4" max="1.8" step="0.1" value="1" data-world-sensitivity /></label>
          <label class="mw-bob-option"><span>{isEn ? 'Gentle walking motion' : '轻微行走起伏'}</span><input type="checkbox" data-world-bob /></label>
        <label><span>{isEn ? 'Background track' : '背景曲目'}</span>
          <select data-world-track>
            <option value="shuffle">{isEn ? 'Shuffle' : '随机播放'}</option>
            {tracks.map(track => <option value={track.file}>{isEn ? track.nameEn : track.name}</option>)}
          </select>
        </label>
      </div>
    </dialog>
    <nav class="mw-waymarks" data-world-marks aria-label={isEn ? 'Courtyard landmarks' : '庭中去处'}>
      {marks.map(mark => <button type="button" class="mw-waymark" data-world-mark={mark.id} data-primary={mark.primary ? 'true' : undefined}
        aria-label={mark.id === 'bench' || mark.id === 'lantern' ? (isEn ? 'Walk to ' : '前往') + mark.label : (isEn ? 'Open ' : '打开') + mark.label} hidden>
        <span class="mw-mark-symbol"><Icon name={'mdi:' + mark.icon} /></span><span class="mw-mark-label">{mark.label}</span>
      </button>)}
    </nav>
    <div class="mw-reticle" data-world-reticle aria-hidden="true"><span></span></div>
    <div class="mw-thumbstick" data-world-stick role="group" aria-label={isEn ? 'Drag to walk' : '拖动摇杆行走'}><span class="mw-thumbstick-ring"></span><span class="mw-thumbstick-knob" data-world-stick-thumb></span></div>

    <section class="mw-fallback" data-world-fallback aria-labelledby="mw-fallback-title" hidden>
      <img src={`${base}/world/immortal-mountains-panorama.webp`} width="2172" height="724" alt="" loading="lazy" decoding="async" />
      <div class="mw-fallback-copy">
        <p class="mw-eyebrow">{isEn ? 'Beyond the clouds' : '云深处，灯尚明'}</p>
        <h1 id="mw-fallback-title">{isEn ? 'Come in. Stay a while.' : '云庭书斋'}</h1>
        <p data-world-failure>{isEn ? 'The 3D scene is unavailable in this browser. The writing is still here.' : '此浏览器暂时无法展开三维场景，仍可直接翻阅这里的文字。'}</p>
        <nav aria-label={isEn ? 'Read the site' : '直接阅读'}><a href={`${prefix}/static/`}>{isEn ? 'Static site' : '静态页面'}</a><a href={`${prefix}/blog`}>{isEn ? 'Read the blog' : '翻阅文章'}</a><a href={`${prefix}/projects`}>{isEn ? 'Projects' : '查看项目'}</a><a href={`${prefix}/cv`}>{isEn ? 'About & CV' : '关于我'}</a></nav>
      </div>
    </section>

    <footer class="mw-hud">
      <div class="mw-place"><span class="mw-place-overline">{isEn ? 'YOU ARE HERE' : '此刻所在'}</span><strong data-world-location>{isEn ? 'Cloudwatch Landing' : '候云台'}</strong><span class="mw-place-note">{isEn ? 'Take your time.' : '此间无事，随意走走。'}</span></div>
      <div class="mw-hint" data-world-hint role="status" hidden>
        <p class="mw-hint-desktop"><span><kbd>WASD</kbd> {isEn ? 'walk' : '行走'}</span><span class="mw-look-locked">{isEn ? 'Mouse to look' : '鼠标环顾'}</span><span class="mw-look-pointer">{isEn ? 'Drag or move to the edge to look' : '拖动或靠边环顾'}</span><span class="mw-look-pending">{isEn ? 'Locking the mouse…' : '正在锁定鼠标…'}</span><span><kbd>Shift</kbd> {isEn ? 'run' : '奔跑'}</span><span><kbd>Esc</kbd> {isEn ? 'pause' : '暂停'}</span></p>
        <p class="mw-hint-touch">{isEn ? 'Left to walk · drag right to look · tap the object prompt' : '左侧行走 · 右侧环顾 · 轻触物件提示'}</p>
        <button type="button" data-world-action="dismiss-hint" aria-keyshortcuts="H" title={isEn ? 'Dismiss (H)' : '收起提示（H）'} aria-label={isEn ? 'Dismiss movement guide' : '收起操作提示'}>×</button>
      </div>
      <button type="button" class="mw-map-button" data-world-action="map"><svg viewBox="0 0 36 36" fill="none" aria-hidden="true"><path d="m5 9 8-3 10 3 8-3v22l-8 3-10-3-8 3V9Zm8-3v22m10-19v22" /><path d="m9 20 9-6 9 7" stroke-dasharray="2 3" /></svg><span>{isEn ? 'Around here' : '山居小引'}</span></button>
    </footer>

    <button type="button" class="mw-interact" data-world-interaction data-world-action="interact" aria-keyshortcuts="E" hidden><kbd>E</kbd><span data-world-interaction-label></span><span class="mw-interact-touch">{isEn ? 'Tap' : '轻触'}</span></button>
    <button type="button" class="mw-stand" data-world-stand aria-keyshortcuts="E" hidden><kbd>E</kbd> {isEn ? 'Stand up' : '起身'}</button>
    <div class="mw-toast" data-world-toast role="status" hidden></div>

    <dialog class="mw-fall" data-world-fall aria-labelledby="fall-message">
      <div class="mw-fall-panel">
        <p id="fall-message">{isEn ? 'Let’s explore the land ahead another time.' : '前面的区域，以后再来探索吧'}</p>
        <button type="button" data-world-respawn>{isEn ? 'Return to the entrance' : '回到初始位置'}</button>
      </div>
    </dialog>
    <CourtyardFolio {isEn}/>
    <script is:inline type="application/json" id="mountain-world-config" set:html={config}></script>
  </div>
  <noscript><style is:inline>[data-world-load]{display:none!important}</style></noscript>
  <script>
    import { createAmbience } from '../scripts/mountain-world/music';
    import { createCourtyardMouseLock } from '../scripts/mountain-world/pointer-lock';
    const courtyard = document.querySelector<HTMLElement>('[data-mountain-world]');
    courtyard?.querySelector<HTMLButtonElement>('[data-world-load]')?.addEventListener('click', async event => {
      courtyard.dataset.state = 'loading';
      const canvas = courtyard.querySelector<HTMLCanvasElement>('#mountain-canvas')!;
      const mouseLock = createCourtyardMouseLock(courtyard, canvas);
      if (event.detail > 0) mouseLock.remember(event.clientX, event.clientY);
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const ambience = createAmbience(base, () => courtyard.dispatchEvent(new Event('mountain-music-error')));
      let sound = true;
      try {
        sound = localStorage.getItem('mountain-study:music') !== 'off';
        ambience.select(localStorage.getItem('mountain-study:track') || 'shuffle');
      } catch {}
      if (sound) ambience.toggle();
      // Mouse lock and audio playback both use the original entrance gesture.
      if (!matchMedia('(pointer: coarse)').matches && canvas.requestPointerLock) mouseLock.start();
      const releaseLock = () => { if (document.pointerLockElement === canvas) document.exitPointerLock(); };
      const pending = new AbortController();
      document.addEventListener('visibilitychange', () => ambience.setHidden(document.hidden), { signal: pending.signal });
      window.addEventListener('pagehide', event => {
        if (!event.persisted) { pending.abort(); mouseLock.dispose(); ambience.dispose(); releaseLock(); }
      }, { signal: pending.signal });
      try {
        const { initializeWorld } = await import('../scripts/mountain-world/main');
        if (pending.signal.aborted) return;
        pending.abort();
        await initializeWorld(courtyard, ambience, mouseLock);
      } catch {
        pending.abort(); mouseLock.dispose(); ambience.dispose(); releaseLock();
        courtyard.dataset.state = 'failed';
        courtyard.querySelector<HTMLElement>('[data-world-fallback]')!.hidden = false;
      }
    }, { once: true });
  </script>
</Layout>
