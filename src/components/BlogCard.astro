---
import { postDate, postDescription, postSlug, type BlogPostEntry } from '../utils/posts';
import PostIllustration from './PostIllustration.astro';

interface Props { post: BlogPostEntry; isEn: boolean; }
const { post, isEn } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = postDescription(post);
const slug = postSlug(post);
const headingId = `card-${slug}`;
---
<li class="post-item blog-card" data-category={post.data.category || ''}>
  <a class="card-link" href={`${base}${isEn ? '/en' : ''}/blog/${slug}`} aria-labelledby={headingId}>
    <div class="card-copy">
      <div class="card-meta">
        {post.data.category && <span>{post.data.category}</span>}
        <time datetime={post.data.pubDate.toISOString()}>{postDate(post.data.pubDate, isEn)}</time>
      </div>
      <h2 id={headingId}>{post.data.title}</h2>
      {description && <p>{description}</p>}
    </div>
    <PostIllustration {post} />
  </a>
</li>

<style>
  .blog-card[hidden] { display: none; }
  .card-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(9rem, 23%, 13rem);
    align-items: center;
    gap: clamp(14px, 3vw, 30px);
    padding: clamp(14px, 2.2vw, 22px);
    border-block: 1px solid var(--line);
    border-top-color: var(--rule);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
  }
  .card-copy { min-width: 0; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; color: var(--muted); font-family: var(--font-sans); font-size: .875rem; }
  .card-meta span { color: var(--accent); font-weight: 650; }
  h2 { margin: .35rem 0 0; font-family: var(--font-serif); font-weight: 750; font-size: clamp(1.28rem, 2.35vw, 1.9rem); line-height: 1.35; overflow-wrap: anywhere; }
  p {
    margin: .42rem 0 0;
    color: var(--body);
    font-size: 1rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .card-link:is(:hover, :focus-visible) h2 { color: var(--accent); text-decoration: underline; text-underline-offset: .14em; }
  .card-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 640px) {
    .card-link { grid-template-columns: minmax(0, 1fr) clamp(4rem, 24%, 8.5rem); gap: 12px; }
  }
  @media (max-width: 340px) {
    .card-link { grid-template-columns: minmax(0, 1fr); }
    .card-link :global(.post-illustration) { width: 5rem; }
  }
</style>
