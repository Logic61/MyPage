---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = Astro.url.pathname.slice(base.length).startsWith('/en');
const {
  title = 'Shane Lorien',
  description = isEn ? 'Notes on mathematics, computer science, and reading by Shane Lorien.' : 'Shane Lorien 的个人博客，记录数学、计算机与阅读中的思考。',
} = Astro.props;
---
<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/avatar.jpg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch {}
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', savedTheme === 'dark' || (savedTheme !== 'light' && prefersDark));
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to content' : '跳至正文'}</a>
    <slot />
  </body>
</html>
