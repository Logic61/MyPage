---
import '../styles/global.css';
import '../styles/study-pages.css';
import '../styles/study-collections.css';
import InkLandscape from '../components/InkLandscape.astro';
import StudyBackdrop from '../components/StudyBackdrop.astro';
interface Props {
  title?: string;
  description?: string;
  section?: 'home' | 'archive' | 'article' | 'cv' | 'projects';
  spatial?: boolean;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isEn = Astro.url.pathname.slice(base.length).startsWith('/en');
const {
  section,
  spatial = false,
  title = 'Shane Lorien',
  description = isEn ? 'Notes on mathematics, computer science, and reading by Shane Lorien.' : 'Shane Lorien 的个人博客，记录数学、计算机与阅读中的思考。',
} = Astro.props;
const studyPage = !spatial && ['archive', 'article', 'cv', 'projects'].includes(section ?? '');
---
<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'} data-section={section} class:list={{ 'archive-catalogue': section === 'archive', 'spatial-home': spatial, 'study-page': studyPage }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/avatar.jpg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      let savedTheme;
      try { savedTheme = localStorage.getItem('theme'); } catch {}
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', savedTheme === 'dark' || (savedTheme !== 'light' && prefersDark));
    </script>
  </head>
  <body>
    {studyPage && <StudyBackdrop />}
    <slot name="background">{!section && <InkLandscape />}</slot>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to content' : '跳至正文'}</a>
    <slot />
    <script>
      import '../scripts/site-motion.js';
    </script>
  </body>
</html>
